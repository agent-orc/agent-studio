# Host-owned provider and Git configuration for the one-box runner roles.
#
# Copy to `runner.env` (never commit it) or let
# `scripts/compose-distributed-bootstrap.sh` create it for you. The older
# runner bootstrap command now calls the same one-box bootstrap.
#
# Both role daemons read THIS ONE file. Keep it free of per-runner
# identity: `docker-compose.yml` already sets RUNNER_SERVER_URL, RUNNER_ROLE,
# and RUNNER_AUTH_TOKEN_FILE per service, and those service-level values win
# over anything set here.
#
# Compose reserves RUNNER_ID and RUNNER_NAME for distinct, persistent coding
# and review identities. Values in this file cannot override those identities.
#
# The systemd host uses a different template with different paths:
# deploy/release/agent-host/runner.env.template. Do not mix the two.

# Set Git remotes and credential mount paths in .env. Compose projects these
# into both services; service environment values override this file.

# Concurrent attempts per container.
RUNNER_MAX_PARALLELISM=1

# Coding-agent provider authentication. Headless containers have no interactive
# login and no ~/.claude, so exactly one of these must be supplied at runtime.
# Values stay in this file and reach the container as environment variables;
# they are never baked into an image (.dockerignore excludes *.env from every
# build context).
#
# Claude: create a long-lived token on a machine where you are logged in with
#   claude setup-token
# Codex: supply an OpenAI key instead, or use Claude only.
#
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
