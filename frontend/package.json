{
  "name": "frontend",
  "scripts": {
    "ng": "ng",
    "prestart": "npm run lint",
    "start": "ng serve frontend --proxy-config proxy.conf.json",
    "build": "node scripts/build-studio.mjs",
    "typecheck": "tsc --project tsconfig.app.json --noEmit",
    "mockup:chat": "ng serve next-gen-chat-mockup --port 4022 --host 127.0.0.1",
    "build:mockup:chat": "ng build next-gen-chat-mockup",
    "mockup:plan": "ng serve plan-strip-mockup --port 4023 --host 127.0.0.1",
    "build:mockup:plan": "ng build plan-strip-mockup",
    "mockup:result": "ng serve result-view-mockup --port 4029 --host 127.0.0.1",
    "build:mockup:result": "ng build result-view-mockup",
    "mockup:waitson": "ng serve waits-on-chip-mockup --port 4031 --host 127.0.0.1",
    "build:mockup:waitson": "ng build waits-on-chip-mockup",
    "mockup:planning": "ng serve planning-visibility-mockup --port 4032 --host 127.0.0.1",
    "build:mockup:planning": "ng build planning-visibility-mockup",
    "mockup:usage": "ng serve usage-chips-mockup --port 4034 --host 127.0.0.1",
    "build:mockup:usage": "ng build usage-chips-mockup",
    "mockup:usage-header": "ng serve usage-header-mockup --port 4035 --host 127.0.0.1",
    "build:mockup:usage-header": "ng build usage-header-mockup",
    "postinstall": "node scripts/patch-coding-agent-chat-model-selector.mjs && node scripts/patch-coding-agent-chat-technical-blocks.mjs",
    "test": "ng test",
    "test:ci": "node scripts/run-unit-tests.mjs",
    "test:release": "ng test frontend --configuration release --watch=false --progress=false --coverage",
    "watch": "ng build frontend --watch --configuration development",
    "e2e": "bash scripts/run-prebuilt-e2e.sh",
    "e2e:mocked": "bash scripts/run-mocked-e2e.sh",
    "e2e:external": "playwright test",
    "e2e:task-switch-budget": "node scripts/run-task-switch-budget.mjs",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report",
    "docs:visual": "playwright test e2e/visual-evidence/readme-screenshots.spec.ts --project=chromium",
    "docs:visual:headed": "playwright test e2e/visual-evidence/readme-screenshots.spec.ts --project=chromium --headed",
    "docs:presentation": "bash ../scripts/presentation-capture/generate.sh",
    "lint": "ng lint && npm run lint:scss && npm run lint:components && npm run lint:structure && npm run lint:process-spawns && npm run lint:skill-scripts && npm run lint:studio-op && npm run lint:product-scenario && npm run lint:tokens && npm run ui:lint",
    "lint:ci": "npm run lint",
    "lint:css": "stylelint \"src/**/*.scss\"",
    "lint:scss": "stylelint \"src/**/*.scss\"",
    "lint:scss:strict": "stylelint \"src/**/*.scss\" --max-warnings=0",
    "lint:scss:fix": "stylelint \"src/**/*.scss\" --fix",
    "lint:components": "node scripts/check-component-size.mjs",
    "lint:process-spawns": "node --test ../scripts/process-spawn-guard.test.mjs",
    "lint:skill-scripts": "node --test ../.agents/skills/task-api/scripts/access.test.mjs",
    "lint:studio-op": "node --test --test-concurrency=1 --test-timeout=60000 ../tools/studio-op/test/batches.test.mjs ../tools/studio-op/test/renewal.test.mjs ../tools/studio-op/test/device-key.test.mjs ../tools/studio-op/test/agent.test.mjs ../tools/studio-op/test/accept-policy.test.mjs ../tools/studio-op/test/credential.test.mjs ../tools/studio-op/test/working-set.test.mjs ../tools/studio-op/test/watch-policy.test.mjs ../tools/studio-op/test/cli.test.mjs ../tools/studio-op/test/login.test.mjs ../tools/studio-op/test/qr.test.mjs",
    "lint:product-scenario": "node --test ../scripts/release/product-scenario/test/product-scenario.test.mjs",
    "lint:structure": "node scripts/check-status-chips.mjs && node scripts/check-component-folders.mjs && node scripts/check-lane-strings.mjs && node scripts/check-disclosure-markers.mjs && node scripts/check-segmented-controls.mjs && node --test scripts/check-status-chips.test.mjs scripts/check-explicit-locales.test.mjs scripts/check-disclosure-markers.test.mjs scripts/check-segmented-controls.test.mjs scripts/serve-prebuilt-frontend.test.mjs scripts/ngsw-navigation-urls.test.mjs scripts/task-header-slots.test.mjs",
    "audit:components": "node scripts/audit-components.mjs --md",
    "audit:orphan-css": "node scripts/find-orphan-css-classes.mjs",
    "ui:inventory": "node scripts/style-inventory.mjs",
    "ui:lint": "eslint projects/studio-ui projects/studio-ui-catalogue/src && stylelint \"projects/studio-ui/**/*.scss\" \"projects/studio-ui-catalogue/**/*.scss\" && node scripts/check-style-tokens.mjs && node scripts/check-ui-library.mjs && node --test scripts/check-ui-library.test.mjs",
    "ui:test": "ng test studio-ui --watch=false --progress=false",
    "ui:catalogue:build": "ng build studio-ui-catalogue",
    "ui:catalogue:check": "npm run ui:catalogue:build && playwright test --config=projects/studio-ui-catalogue/playwright.config.ts",
    "lint:tokens": "node scripts/check-style-tokens.mjs && node --test scripts/check-style-tokens.test.mjs"
  },
  "private": true,
  "packageManager": "npm@11.21.1",
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "@angular/router": "21.2.25",
    "@angular/service-worker": "21.2.25",
    "@microsoft/signalr": "^10.0.0",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "coding-agent-chat": "0.4.1",
    "diff2html": "^3.4.56",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.3",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.25",
    "@angular/cli": "21.2.25",
    "@angular/compiler-cli": "21.2.25",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/dompurify": "^3.0.5",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "21.3.1",
    "color-name": "1.1.4",
    "eslint": "^10.0.3",
    "jsdom": "^29.1.1",
    "postcss-scss": "4.0.9",
    "postcss-value-parser": "4.2.0",
    "prettier": "^3.8.1",
    "stylelint": "^17.11.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-declaration-strict-value": "^1.11.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.56.1",
    "vitest": "^4.1.11"
  }
}
