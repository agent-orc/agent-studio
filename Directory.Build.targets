<Project>
  <!-- A known vulnerable package (NuGet audit NU1902 moderate, NU1903 high, NU1904 critical)
       fails restore and build for production projects. Test projects keep these as warnings.
       This lives in a .targets file because the test projects set IsTestProject in their
       project body, after Directory.Build.props has been evaluated. -->
  <PropertyGroup Condition="'$(IsTestProject)' != 'true'">
    <WarningsAsErrors>$(WarningsAsErrors);NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>
</Project>
