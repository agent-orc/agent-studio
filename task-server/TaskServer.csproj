<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>task-server</AssemblyName>
    <RootNamespace>AgentStudio.TaskServer</RootNamespace>
  </PropertyGroup>

  <Target Name="StampTaskServerBuildIdentity" BeforeTargets="GenerateAssemblyInfo">
    <Exec
      Command="git -C &quot;$(MSBuildProjectDirectory)&quot; rev-parse HEAD"
      ConsoleToMSBuild="true"
      IgnoreExitCode="true"
      StandardOutputImportance="Low"
      StandardErrorImportance="Low"
      Condition="'$(SourceRevisionId)' == ''">
      <Output TaskParameter="ConsoleOutput" PropertyName="SourceRevisionId" />
    </Exec>
    <PropertyGroup>
      <SourceRevisionId Condition="'$(SourceRevisionId)' == ''">unknown</SourceRevisionId>
      <InformationalVersion>$(Version)+sha.$(SourceRevisionId)</InformationalVersion>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyMetadata Include="RepositoryCommit" Value="$(SourceRevisionId)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <!-- Same pin as backend/OrchestratorApi.csproj and runner/AgentRunner.csproj: the
         CLI type/mode vocabulary (CliTypes, CliPermissionModes, CliContextModes,
         CliPermissionFlags) is shared, published data, not a live-process dependency,
         so the P3 administration bundle reads it directly instead of re-deriving it. -->
    <PackageReference Include="CodingAgentRunner" Version="[0.7.0]" />
    <ProjectReference Include="..\contracts\TaskServer.Contracts\TaskServer.Contracts.csproj" />
    <ProjectReference Include="..\retention\AgentStudio.Retention.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="CodingAgentRunner.Model.CliTypes" Alias="CliTypes" />
    <Using Include="CodingAgentRunner.Model.CliPermissionModes" Alias="CliPermissionModes" />
    <Using Include="CodingAgentRunner.Model.CliPermissionFlags" Alias="CliPermissionFlags" />
    <Using Include="CodingAgentRunner.Model.CliContextModes" Alias="CliContextModes" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TaskServer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings*.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!-- The runtime prompt template defaults and the model-routing policy ship with the
       product, not with one process's checkout: embed the same source files the
       monolith reads from disk so the standalone Task Server can serve the P3
       admin/prompts and cli/model-routing/policy routes without a shared filesystem. -->
  <ItemGroup>
    <EmbeddedResource Include="..\prompts\runtime\*.md">
      <LogicalName>AgentStudio.TaskServer.Prompts.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\backend\Policies\model-routing-policy.v1.json"
                      Link="Policies\model-routing-policy.v1.json"
                      LogicalName="AgentStudio.TaskServer.ModelRoutingPolicy" />
  </ItemGroup>

  <Target
    Name="RemoveSingleFilePublishSidecars"
    AfterTargets="Publish"
    Condition="'$(PublishSingleFile)' == 'true' and '$(RuntimeIdentifier)' == 'linux-x64'">
    <Delete Files="$(PublishDir)TaskServer.Contracts.pdb" />
    <Delete Files="$(PublishDir)libe_sqlite3.a" />
    <Delete Files="$(PublishDir)$(AssemblyName).staticwebassets.endpoints.json" />
  </Target>

</Project>
