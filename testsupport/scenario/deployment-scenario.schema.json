{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deployment-scenario.schema.json",
  "title": "Deployment regression scenario",
  "type": "object",
  "required": ["id", "seed", "clock", "smokeStepCount", "fixture", "steps"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "seed": { "type": "integer" },
    "clock": { "type": "string", "format": "date-time" },
    "smokeStepCount": { "type": "integer", "minimum": 1 },
    "fixture": { "type": "object" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "handler", "levels", "assertions"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "handler": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "levels": { "type": "array", "items": { "enum": ["smoke", "full"] }, "minItems": 1 },
          "assertions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["type"],
              "properties": { "type": { "type": "string", "pattern": "^[a-z0-9_]+$" } },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  }
}
