{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-taskboard.local/schemas/persona-item.schema.json",
  "title": "PersonaItemV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "personaId", "roleId", "kind", "title", "body", "project", "evidence", "impact", "urgency", "confidence", "floor", "importance", "fingerprint", "state", "createdAtUtc", "updatedAtUtc", "history"],
  "properties": {
    "id": {"type": "string", "pattern": "^pit_[0-9a-f]{32}$"},
    "personaId": {"type": "string", "minLength": 1},
    "roleId": {"type": "string", "minLength": 1},
    "kind": {"enum": ["finding", "proposal", "decision-request", "report-line"]},
    "title": {"type": "string", "minLength": 1, "maxLength": 120},
    "body": {"type": "string", "minLength": 1, "maxLength": 1200},
    "project": {"type": ["string", "null"]},
    "evidence": {"type": "array", "maxItems": 10, "items": {"type": "object", "additionalProperties": false, "required": ["ref", "measured"], "properties": {"ref": {"type": "string", "minLength": 1}, "measured": {"type": "boolean"}}}},
    "impact": {"type": "integer", "minimum": 1, "maximum": 5},
    "urgency": {"type": "integer", "minimum": 1, "maximum": 5},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "floor": {"type": "integer", "minimum": 0, "maximum": 100},
    "importance": {"type": "integer", "minimum": 0, "maximum": 100},
    "fingerprint": {"type": "string", "minLength": 1},
    "state": {"type": "string", "minLength": 1},
    "createdAtUtc": {"type": "string", "format": "date-time"},
    "updatedAtUtc": {"type": "string", "format": "date-time"},
    "history": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["atUtc", "previousImportance", "importance", "reason", "occurrenceKey"], "properties": {"atUtc": {"type": "string", "format": "date-time"}, "previousImportance": {"type": "integer", "minimum": 0, "maximum": 100}, "importance": {"type": "integer", "minimum": 0, "maximum": 100}, "reason": {"type": "string"}, "occurrenceKey": {"type": "string"}}}},
    "deadlineUtc": {"type": ["string", "null"], "format": "date-time"},
    "draftCard": {"type": "boolean"},
    "options": {"type": ["array", "null"], "minItems": 2, "maxItems": 4, "items": {"type": "string"}},
    "recommendedOption": {"type": ["string", "null"]},
    "dossierKey": {"type": ["string", "null"], "maxLength": 100},
    "dossierSection": {"type": ["string", "null"], "maxLength": 100},
    "draftTitle": {"type": ["string", "null"], "maxLength": 120},
    "draftPrompt": {"type": ["string", "null"], "maxLength": 4000},
    "area": {"type": ["string", "null"], "maxLength": 100}
  }
}
