<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone agent host (RM-5, Runner-Split C). A single self-contained
    console process that runs on Linux or a Windows workstation and consumes the
    Task Server's
    Task-Server API only (REST + lease/heartbeat + log/artifact upload). It owns
    no task state: code arrives via git origin, results leave via the upload +
    external-completion endpoints. See docs/operations/setup/linux-runner-host.md.

    Deliberately independent of OrchestratorApi: the runner ships to a different
    host and consumes the versioned TaskServer.Contracts package. WireModels.cs
    retains only the protocol-v0 declarations needed by the local compatibility
    fallback while mixed installations upgrade.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AgentRunner</RootNamespace>
    <AssemblyName>agent-host</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InformationalVersion Condition="'$(SourceRevisionId)' != ''">$(Version)+sha.$(SourceRevisionId)</InformationalVersion>
    <InformationalVersion Condition="'$(SourceRevisionId)' == ''">$(Version)+sha.unknown</InformationalVersion>
  </PropertyGroup>

  <!--
    The backend integration test (backend.Tests/RemoteRunnerEndToEndTests.cs)
    drives this runner's real TaskServerClient against the in-process backend to
    prove the RM-3/RM-4 wire contract end-to-end. It references the internal
    HttpClient test-seam constructor via this grant. Nothing in the shipped
    runner binary changes.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="OrchestratorApi.Tests" />
    <InternalsVisibleTo Include="AgentRunner.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\contracts\TaskServer.Contracts\TaskServer.Contracts.csproj" />
    <ProjectReference Include="..\cli-hosting\AgentStudio.CliHosting.csproj" />
    <!--
      T1 (AGT-2370): the detached worker drives the coding CLI through the
      CodingAgentRunner library. PackageReference with an exact pin, NOT a
      ProjectReference: the runner is a separately deployed artifact
      (/opt/agent-host) and the backend already pins the same package - two
      reference paths would be exactly the version drift the
      zielbild-komponenten-protokolle doc warns about. Keep this pin identical
      to the one in backend/OrchestratorApi.csproj (T4 adds the guard test).
    -->
    <PackageReference Include="CodingAgentRunner" Version="[0.7.0]" />
  </ItemGroup>

</Project>
