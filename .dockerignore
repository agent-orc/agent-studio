.git
.tmp
# Never let credentials or local environment files enter repository-root
# Docker build contexts. Templates remain available to image builds.
**/*.env
**/*.token
**/.git-credentials
!**/*.env.template
!**/*.env.example
!**/*.token.template
!**/*.token.example
!**/.git-credentials.template
!**/.git-credentials.example
# Machine-local configuration must never override the container's env-based config.
**/appsettings.Local.json
**/appsettings.Development.json
**/bin
**/obj
**/node_modules
**/dist
**/.angular
results
artifacts
docs/**
!docs/app/
!docs/app/**
# OrchestratorApi embeds the reviewed route inventory as a compiled resource.
!docs/studio-route-ownership/
!docs/studio-route-ownership/routes.json
**/*.log
**/cli-output.log
