# One launcher call per connection from agent-work-launcher.socket. The
# wrapper verifies root ownership of itself, its configuration and the
# agent-host release before agent-host validates and runs the call.
[Unit]
Description=Agent Studio narrow work-container launcher call
After=docker.service
Requires=agent-work.slice

[Service]
Type=oneshot
User=root
Slice=agent-work.slice
ExecStart=/usr/local/sbin/agent-work-launcher --stdio
StandardInput=socket
StandardOutput=socket
StandardError=journal
# The launcher bounds socket I/O and each operation. The unit is the
# backstop for wrapper startup, runtime processes and cleanup.
TimeoutStartSec=32min
TimeoutStopSec=5s
CPUQuota=50%
MemoryMax=256M
MemorySwapMax=0
TasksMax=64
# The runtime CLI keeps its normal root configuration and runtime directories.
NoNewPrivileges=true
