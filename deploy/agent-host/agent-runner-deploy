#!/usr/bin/env bash
# Promote a staged release or apply one allowlisted role configuration value.
set -euo pipefail
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

readonly service_user="agent"
readonly service_group="agent"
readonly deploy_root="/var/lib/agent-runner/deploy"
readonly incoming_root="$deploy_root/incoming"
readonly accepted_root="$deploy_root/accepted"
readonly product_root="/opt/agent-host"
readonly releases_root="$product_root/releases"
readonly current_link="$product_root/current"
readonly compatibility_link="/opt/agent-runner"
readonly legacy_backup="/opt/agent-runner.pre-hardening"
readonly config_policy="/usr/local/libexec/agent-runner-config-policy"
readonly deps_closure_validator="/usr/local/libexec/agent-runner-deps-closure"
readonly maximum_release_bytes=$((1024 * 1024 * 1024))
readonly main_pid_wait_seconds=30
readonly main_pid_poll_seconds=0.2
readonly maximum_deps_json_bytes=$((16 * 1024 * 1024))
readonly smoke_timeout_seconds=10
readonly restart_observation_seconds=15
readonly -a release_units=(agent-runner.service agent-runner-review.service)
readonly review_unit="agent-runner-review.service"
readonly -a review_env_files=(/etc/agent-runner/runner-review.env /etc/agent-runner/review.env)
readonly default_review_state_dir="/var/lib/agent-runner-review/state"
readonly agent_host_binary="$product_root/agent-host"
force_restart=0

die() {
  printf 'agent-runner-deploy: %s\n' "$*" >&2
  exit 2
}

# The busy-slot policy lives in the runner binary, not here, so the deploy
# script and the daemon cannot drift on what "busy" means.
review_state_dir() {
  local file
  local value=""

  for file in "${review_env_files[@]}"; do
    [[ -f "$file" && ! -L "$file" ]] || continue
    value="$(awk -F= '$1 == "RUNNER_STATE_DIR" { print substr($0, index($0, "=") + 1) }' "$file" | tail -n 1)"
    [[ -n "$value" ]] && break
  done
  printf '%s\n' "${value:-$default_review_state_dir}"
}

# Refuses a restart that would discard running review gate work. A review
# takes tens of minutes, so the sanctioned path is a drain; --force stays
# available for an operator who has decided the loss is acceptable.
assert_review_restart_is_safe() {
  local guard_status=0

  if ((force_restart)); then
    printf 'agent-runner-deploy: --force given; skipping the review restart guard\n' >&2
    return 0
  fi
  if [[ ! -x "$agent_host_binary" ]]; then
    printf 'agent-runner-deploy: review restart guard unavailable (%s is not executable); continuing\n' \
      "$agent_host_binary" >&2
    return 0
  fi
  if ! systemctl is-active --quiet "$review_unit"; then
    return 0
  fi

  env -i PATH="$PATH" HOME=/root \
    "$agent_host_binary" --restart-guard --role review --state-dir "$(review_state_dir)" \
    || guard_status="$?"
  case "$guard_status" in
    0) return 0 ;;
    3)
      logger -p authpriv.notice -t agent-runner-deploy \
        "action=restart-guard unit=$review_unit result=refused" || true
      die "refusing to restart $review_unit while review slots are busy. Run 'agent-runner-deploy drain' first, or re-run with --force."
      ;;
    *)
      die "review restart guard failed with exit $guard_status"
      ;;
  esac
}

# Stop claiming, let the running reviews finish, then hand back. The daemon
# exits on an empty slot set and systemd starts a fresh one, so a drain leaves
# the host claiming again without a second operator step.
drain_review_unit() {
  local drain_status=0
  local drain_result

  [[ -x "$agent_host_binary" ]] || die "agent-host is not executable: $agent_host_binary"
  systemctl is-active --quiet "$review_unit" \
    || die "$review_unit is not running; there is nothing to drain"

  env -i PATH="$PATH" HOME=/root \
    "$agent_host_binary" --drain --role review --state-dir "$(review_state_dir)" \
    || drain_status="$?"
  if ((drain_status == 0)); then drain_result="drained"; else drain_result="incomplete"; fi
  logger -p authpriv.notice -t agent-runner-deploy \
    "action=drain unit=$review_unit result=$drain_result exit=$drain_status" || true
  ((drain_status == 0)) || die "review drain did not complete (exit $drain_status)"
  printf 'agent-runner-deploy: %s drained; a restart no longer discards review work\n' "$review_unit"
}

audit_config() {
  local result="$1"
  local detail="$2"

  logger -p authpriv.notice -t agent-runner-deploy \
    "action=config role=$config_role variable=$AGENT_RUNNER_CONFIG_VARIABLE old=$old_value new=$AGENT_RUNNER_CONFIG_VALUE unit=$AGENT_RUNNER_CONFIG_UNIT result=$result detail=$detail"
}

unit_loads_environment_file() {
  local environment_files="$1"
  local expected_path="$2"

  awk '{ print $1 }' <<<"$environment_files" | grep -Fxq -- "$expected_path"
}

read_process_environment_value() {
  local main_pid="$1"
  local variable="$2"

  tr '\0' '\n' <"/proc/$main_pid/environ" \
    | awk -F= -v key="$variable" '$1 == key { print substr($0, index($0, "=") + 1) }'
}

wait_for_new_main_pid() {
  local unit="$1"
  local previous_main_pid="$2"
  local timeout_seconds="${3:-$main_pid_wait_seconds}"
  local deadline=$((SECONDS + timeout_seconds))
  local unit_state
  local active_state
  local observed_main_pid

  while true; do
    if unit_state="$(systemctl show --property=ActiveState --property=MainPID "$unit" 2>/dev/null)"; then
      active_state="$(awk -F= '$1 == "ActiveState" { print $2 }' <<<"$unit_state")"
      observed_main_pid="$(awk -F= '$1 == "MainPID" { print $2 }' <<<"$unit_state")"
      if [[ "$active_state" == "active" \
          && "$observed_main_pid" =~ ^[1-9][0-9]*$ \
          && "$observed_main_pid" != "$previous_main_pid" ]]; then
        printf '%s\n' "$observed_main_pid"
        return 0
      fi
    fi

    ((SECONDS < deadline)) || return 1
    sleep "$main_pid_poll_seconds"
  done
}

restart_unit_and_wait_for_new_main_pid() {
  local unit="$1"
  local previous_main_pid="$2"
  local timeout_seconds="${3:-$main_pid_wait_seconds}"

  systemctl restart "$unit" >/dev/null || return 10
  wait_for_new_main_pid "$unit" "$previous_main_pid" "$timeout_seconds" || return 11
}

rollback_config() {
  local reason="$1"

  if [[ -n "${rollback_file:-}" && -f "$rollback_file" ]]; then
    mv -fT -- "$rollback_file" "$config_env_file"
    rollback_file=""
    systemctl restart "$AGENT_RUNNER_CONFIG_UNIT" >/dev/null 2>&1 || true
  fi
  audit_config "rolled-back" "$reason" || true
  die "configuration was rolled back: $reason"
}

configure_role() {
  config_role="$1"
  local requested_variable="$2"
  local requested_value="$3"

  [[ -f "$config_policy" && ! -L "$config_policy" ]] \
    || die "configuration policy is missing or invalid: $config_policy"
  [[ "$(stat -c '%U:%G:%a' "$config_policy")" == "root:root:755" ]] \
    || die "configuration policy must be root:root mode 0755"
  # shellcheck source=/dev/null
  source "$config_policy"
  agent_runner_resolve_config "$config_role" "$requested_variable" "$requested_value" \
    || die "configuration request was rejected"

  systemctl cat "$AGENT_RUNNER_CONFIG_UNIT" >/dev/null \
    || die "role unit is not installed: $AGENT_RUNNER_CONFIG_UNIT"
  local unit_environment_files
  unit_environment_files="$(systemctl show --property=EnvironmentFiles --value "$AGENT_RUNNER_CONFIG_UNIT")"
  # systemd applies EnvironmentFile values after Environment= values. A role
  # file such as runner-review.env therefore overrides the main unit's
  # RUNNER_MAX_PARALLELISM=2 default. The loaded-file check here establishes
  # the source, and the new-MainPID /proc check below proves the effective value.
  if [[ -f "$AGENT_RUNNER_CONFIG_PRIMARY_ENV" ]] \
      && unit_loads_environment_file "$unit_environment_files" "$AGENT_RUNNER_CONFIG_PRIMARY_ENV"; then
    config_env_file="$AGENT_RUNNER_CONFIG_PRIMARY_ENV"
  elif unit_loads_environment_file "$unit_environment_files" "$AGENT_RUNNER_CONFIG_FALLBACK_ENV"; then
    config_env_file="$AGENT_RUNNER_CONFIG_FALLBACK_ENV"
  else
    die "role unit does not load an approved EnvironmentFile: $AGENT_RUNNER_CONFIG_UNIT"
  fi

  [[ -f "$config_env_file" && ! -L "$config_env_file" ]] \
    || die "role EnvironmentFile is missing or invalid: $config_env_file"
  [[ "$(stat -c '%U:%G:%a' "$config_env_file")" == "root:$service_group:640" ]] \
    || die "role EnvironmentFile must be root:$service_group mode 0640: $config_env_file"

  local config_directory
  local candidate_file
  local existing_count
  config_directory="$(dirname "$config_env_file")"
  existing_count="$(awk -F= -v key="$AGENT_RUNNER_CONFIG_VARIABLE" '$1 == key { count++ } END { print count + 0 }' "$config_env_file")"
  ((existing_count <= 1)) \
    || die "role EnvironmentFile contains duplicate $AGENT_RUNNER_CONFIG_VARIABLE entries"
  old_value="$(awk -F= -v key="$AGENT_RUNNER_CONFIG_VARIABLE" '$1 == key { print substr($0, index($0, "=") + 1) }' "$config_env_file")"
  old_value="${old_value:-unset}"

  if [[ "$AGENT_RUNNER_CONFIG_UNIT" == "$review_unit" ]]; then
    assert_review_restart_is_safe
  fi

  local previous_main_pid
  if ! previous_main_pid="$(systemctl show --property=MainPID --value "$AGENT_RUNNER_CONFIG_UNIT")"; then
    die "could not query the role unit MainPID before restart: $AGENT_RUNNER_CONFIG_UNIT"
  fi
  [[ "$previous_main_pid" =~ ^[0-9]+$ ]] \
    || die "role unit returned an invalid MainPID before restart: $AGENT_RUNNER_CONFIG_UNIT"

  candidate_file="$(mktemp "$config_directory/.agent-runner-config.candidate.XXXXXX")"
  rollback_file="$(mktemp "$config_directory/.agent-runner-config.rollback.XXXXXX")"
  trap 'rm -f -- "${candidate_file:-}" "${rollback_file:-}"' EXIT
  cp --preserve=mode,ownership,timestamps -- "$config_env_file" "$rollback_file"

  awk -v key="$AGENT_RUNNER_CONFIG_VARIABLE" -v value="$AGENT_RUNNER_CONFIG_VALUE" '
    BEGIN { replaced = 0 }
    index($0, key "=") == 1 {
      if (replaced == 0) {
        print key "=" value
        replaced = 1
      }
      next
    }
    { print }
    END {
      if (replaced == 0)
        print key "=" value
    }
  ' "$config_env_file" >"$candidate_file"
  chown root:"$service_group" "$candidate_file"
  chmod 0640 "$candidate_file"
  sync -f "$candidate_file"
  mv -fT -- "$candidate_file" "$config_env_file"
  candidate_file=""

  local main_pid
  local process_value
  local restart_result
  if main_pid="$(restart_unit_and_wait_for_new_main_pid \
      "$AGENT_RUNNER_CONFIG_UNIT" "$previous_main_pid")"; then
    restart_result=0
  else
    restart_result="$?"
  fi
  case "$restart_result" in
    0) ;;
    10) rollback_config "unit-restart-failed" ;;
    *) rollback_config "new-main-pid-timeout" ;;
  esac
  if ! process_value="$(read_process_environment_value \
      "$main_pid" "$AGENT_RUNNER_CONFIG_VARIABLE")"; then
    rollback_config "process-environment-read-failed"
  fi
  [[ "$process_value" == "$AGENT_RUNNER_CONFIG_VALUE" ]] \
    || rollback_config "process-environment-mismatch"

  if ! audit_config "applied" "pid=$main_pid"; then
    rollback_config "journal-write-failed"
  fi
  rm -f -- "$rollback_file"
  rollback_file=""
  trap - EXIT
  printf 'agent-runner-deploy: configured role=%s variable=%s value=%s unit=%s pid=%s\n' \
    "$config_role" \
    "$AGENT_RUNNER_CONFIG_VARIABLE" \
    "$AGENT_RUNNER_CONFIG_VALUE" \
    "$AGENT_RUNNER_CONFIG_UNIT" \
    "$main_pid"
}

current_release_id() {
  local target
  local release_id

  [[ -L "$current_link" ]] || return 1
  target="$(readlink -f -- "$current_link")" || return 1
  [[ "$(dirname -- "$target")" == "$releases_root" ]] || return 1
  release_id="$(basename -- "$target")"
  [[ "$release_id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || return 1
  printf '%s\n' "$release_id"
}

restart_count() {
  local unit="$1"
  local count

  count="$(systemctl show --property=NRestarts --value "$unit")" || return 1
  [[ "$count" =~ ^[0-9]+$ ]] || return 1
  printf '%s\n' "$count"
}

print_rollback_hint() {
  local previous_release_id="$1"

  if [[ -n "$previous_release_id" ]]; then
    printf 'agent-runner-deploy: previous release: %s\n' "$previous_release_id" >&2
    printf '%s\n' \
      "agent-runner-deploy: rollback command: sudo ln -sfnT $releases_root/$previous_release_id $current_link && sudo systemctl restart ${release_units[*]}" >&2
  else
    printf 'agent-runner-deploy: no previous release was available for rollback\n' >&2
  fi
}

post_restart_failure() {
  local release_id="$1"
  local previous_release_id="$2"
  local detail="$3"

  logger -p authpriv.notice -t agent-runner-deploy \
    "action=release release=$release_id previous=${previous_release_id:-none} result=post-restart-failed detail=$detail" || true
  print_rollback_hint "$previous_release_id"
  die "post-restart service check failed: $detail"
}

restart_release_services() {
  local release_id="$1"
  local previous_release_id="$2"
  shift 2
  local -a before_restart_counts=("$@")
  local -a observed_restart_counts=()
  local unit
  local unit_index
  local count
  local deadline

  assert_review_restart_is_safe

  for unit_index in "${!release_units[@]}"; do
    unit="${release_units[$unit_index]}"
    if ! systemctl restart "$unit"; then
      post_restart_failure "$release_id" "$previous_release_id" "unit-restart-failed:$unit"
    fi
  done

  for unit_index in "${!release_units[@]}"; do
    unit="${release_units[$unit_index]}"
    if ! systemctl is-active --quiet "$unit"; then
      post_restart_failure "$release_id" "$previous_release_id" "unit-not-active:$unit"
    fi
    if ! count="$(restart_count "$unit")"; then
      post_restart_failure "$release_id" "$previous_release_id" "restart-counter-query-failed:$unit"
    fi
    if ((count > before_restart_counts[unit_index])); then
      post_restart_failure "$release_id" "$previous_release_id" \
        "restart-counter-increased:$unit:${before_restart_counts[$unit_index]}->$count"
    fi
    observed_restart_counts+=("$count")
  done

  deadline=$((SECONDS + restart_observation_seconds))
  while ((SECONDS < deadline)); do
    sleep 1
    for unit_index in "${!release_units[@]}"; do
      unit="${release_units[$unit_index]}"
      if ! count="$(restart_count "$unit")"; then
        post_restart_failure "$release_id" "$previous_release_id" "restart-counter-query-failed:$unit"
      fi
      if [[ "$count" != "${observed_restart_counts[$unit_index]}" ]]; then
        post_restart_failure "$release_id" "$previous_release_id" \
          "restart-counter-changed:$unit:${observed_restart_counts[$unit_index]}->$count"
      fi
      if ! systemctl is-active --quiet "$unit"; then
        post_restart_failure "$release_id" "$previous_release_id" "unit-left-active-state:$unit"
      fi
    done
  done
}

promote_release() {
  command -v find >/dev/null || die "find is required"
  command -v readlink >/dev/null || die "readlink is required"
  command -v runuser >/dev/null || die "runuser is required"
  command -v systemctl >/dev/null || die "systemctl is required"
  command -v timeout >/dev/null || die "timeout is required"
  command -v dotnet >/dev/null || die "dotnet is required"
  [[ -x /usr/bin/python3 ]] || die "/usr/bin/python3 is required"
  id "$service_user" >/dev/null 2>&1 || die "service account '$service_user' does not exist"
  getent group "$service_group" >/dev/null || die "service group '$service_group' does not exist"
  [[ -f "$deps_closure_validator" && ! -L "$deps_closure_validator" && -x "$deps_closure_validator" ]] \
    || die "dependency closure validator is missing or invalid: $deps_closure_validator"
  [[ "$(stat -c '%U:%G:%a' "$deps_closure_validator")" == "root:root:755" ]] \
    || die "dependency closure validator must be root:root mode 0755"

  local dotnet_path
  local dotnet_root
  dotnet_path="$(readlink -f -- "$(command -v dotnet)")" \
    || die "could not resolve the dotnet host"
  [[ -x "$dotnet_path" ]] || die "resolved dotnet host is not executable: $dotnet_path"
  dotnet_root="$(dirname -- "$dotnet_path")"

  local previous_release_id=""
  previous_release_id="$(current_release_id || true)"
  local -a before_restart_counts=()
  local unit
  local count
  for unit in "${release_units[@]}"; do
    systemctl cat "$unit" >/dev/null || die "release unit is not installed: $unit"
    count="$(restart_count "$unit")" || die "could not read restart counter for $unit"
    before_restart_counts+=("$count")
  done

  install -d -o root -g root -m 0755 "$deploy_root" "$accepted_root" "$product_root" "$releases_root"
  [[ -d "$incoming_root" ]] || die "staged release is missing: $incoming_root"
  [[ ! -L "$incoming_root" ]] || die "staged release root must not be a symbolic link"
  [[ "$(stat -c '%U:%G' "$incoming_root")" == "$service_user:$service_group" ]] \
    || die "staged release must be owned by $service_user:$service_group"

  local invalid_entry
  invalid_entry="$(find "$incoming_root" -xdev -mindepth 1 ! -type d ! -type f -print -quit)"
  [[ -z "$invalid_entry" ]] || die "staged release contains a non-regular entry: $invalid_entry"

  local release_id_file="$incoming_root/release-id"
  local release_id
  [[ -f "$release_id_file" && ! -L "$release_id_file" ]] || die "release-id is missing or invalid"
  release_id="$(<"$release_id_file")"
  [[ "$release_id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] \
    || die "release-id must contain 1 to 64 safe characters"

  local required_file
  for required_file in agent-host agent-host.dll agent-host.deps.json agent-host.runtimeconfig.json; do
    [[ -f "$incoming_root/$required_file" && ! -L "$incoming_root/$required_file" ]] \
      || die "required release file is missing or invalid: $required_file"
  done
  [[ -x "$incoming_root/agent-host" ]] || die "agent-host is not executable"

  local deps_json_bytes
  deps_json_bytes="$(stat -c '%s' "$incoming_root/agent-host.deps.json")"
  [[ "$deps_json_bytes" =~ ^[0-9]+$ ]] || die "could not measure agent-host.deps.json"
  ((deps_json_bytes <= maximum_deps_json_bytes)) \
    || die "agent-host.deps.json exceeds the 16 MiB safety limit"

  local release_bytes
  release_bytes="$(du -sb "$incoming_root" | awk '{print $1}')"
  [[ "$release_bytes" =~ ^[0-9]+$ ]] || die "could not measure staged release"
  ((release_bytes <= maximum_release_bytes)) || die "staged release exceeds the 1 GiB safety limit"

  local release_root="$releases_root/$release_id"
  local accepted_release="$accepted_root/$release_id"
  [[ ! -e "$release_root" ]] || die "immutable release already exists: $release_root"
  [[ ! -e "$accepted_release" ]] || die "accepted upload already exists: $accepted_release"
  if [[ -e "$compatibility_link" && ! -L "$compatibility_link" ]]; then
    [[ ! -e "$legacy_backup" ]] || die "legacy compatibility backup already exists: $legacy_backup"
  fi

  local staging_root="$releases_root/.staging.$release_id.$$"
  trap 'rm -rf --one-file-system -- "$staging_root"' EXIT
  install -d -o root -g root -m 0755 "$staging_root"
  cp -R --no-preserve=all "$incoming_root/." "$staging_root/"
  rm -- "$staging_root/release-id"
  chown -R root:root "$staging_root"
  find "$staging_root" -type d -exec chmod 0755 {} +
  find "$staging_root" -type f -exec chmod 0644 {} +
  chmod 0755 "$staging_root/agent-host"

  local closure_output
  local closure_status
  if closure_output="$(
    "$deps_closure_validator" "$staging_root/agent-host.deps.json" "$staging_root" 2>&1
  )"; then
    :
  else
    closure_status=$?
    die "dependency closure validation failed (exit $closure_status): ${closure_output:-no detail}"
  fi

  local smoke_output
  local smoke_status
  if smoke_output="$(
    cd -- "$staging_root"
    timeout --signal=TERM --kill-after=2s "${smoke_timeout_seconds}s" \
      runuser -u "$service_user" -- \
      env -i \
        PATH="$PATH" \
        DOTNET_ROOT="$dotnet_root" \
        DOTNET_ROOT_X64="$dotnet_root" \
        ./agent-host --version 2>&1
  )"; then
    :
  else
    smoke_status=$?
    smoke_output="${smoke_output//$'\n'/; }"
    die "staged agent-host boot smoke check failed (exit $smoke_status): ${smoke_output:-no output}"
  fi

  mv -- "$staging_root" "$release_root"
  trap - EXIT

  ln -sfnT "$release_root" "$current_link"
  chown -h root:root "$current_link"
  if [[ -e "$compatibility_link" && ! -L "$compatibility_link" ]]; then
    mv -- "$compatibility_link" "$legacy_backup"
  fi
  ln -sfnT "$current_link" "$compatibility_link"
  chown -h root:root "$compatibility_link"

  mv -- "$incoming_root" "$accepted_release"
  chown -R root:root "$accepted_release"
  install -d -o "$service_user" -g "$service_group" -m 0750 "$incoming_root"

  restart_release_services \
    "$release_id" \
    "$previous_release_id" \
    "${before_restart_counts[@]}"

  logger -p authpriv.notice -t agent-runner-deploy \
    "action=release release=$release_id previous=${previous_release_id:-none} source=$incoming_root target=$release_root result=activated" || true
  printf 'agent-runner-deploy: promoted and activated release %s at %s\n' "$release_id" "$release_root"
}

main() {
  [[ "$EUID" -eq 0 ]] || die "must run as root through the approved sudo rule"
  command -v flock >/dev/null || die "flock is required"
  command -v stat >/dev/null || die "stat is required"
  install -d -o root -g root -m 0755 "$deploy_root"
  exec 9>"$deploy_root/.deploy.lock"
  flock -n 9 || die "another release promotion or configuration update is already running"

  case "$#:${1:-}" in
    0:)
      promote_release
      ;;
    1:--force)
      force_restart=1
      promote_release
      ;;
    1:drain)
      drain_review_unit
      ;;
    4:config)
      configure_role "$2" "$3" "$4"
      ;;
    5:config)
      [[ "$5" == "--force" ]] || die "unknown configuration flag: $5"
      force_restart=1
      configure_role "$2" "$3" "$4"
      ;;
    *)
      die "usage: agent-runner-deploy [--force] | drain | config <coding|review> RUNNER_MAX_PARALLELISM <1-6> [--force]"
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
