#!/usr/bin/env bash
# Promote a staged release or apply one allowlisted role configuration value.
set -euo pipefail
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

readonly service_user="agent"
readonly service_group="agent"
readonly deploy_root="/var/lib/agent-runner/deploy"
readonly incoming_root="$deploy_root/incoming"
readonly accepted_root="$deploy_root/accepted"
readonly product_root="/opt/agent-host"
readonly releases_root="$product_root/releases"
readonly current_link="$product_root/current"
readonly compatibility_link="/opt/agent-runner"
readonly legacy_backup="/opt/agent-runner.pre-hardening"
readonly config_policy="/usr/local/libexec/agent-runner-config-policy"
readonly deps_closure_validator="/usr/local/libexec/agent-runner-deps-closure"
readonly maximum_release_bytes=$((1024 * 1024 * 1024))
readonly main_pid_wait_seconds=120
readonly main_pid_poll_seconds=0.2
readonly maximum_deps_json_bytes=$((16 * 1024 * 1024))
readonly smoke_timeout_seconds=10
readonly restart_observation_seconds=15
readonly -a release_units=(agent-runner.service agent-runner-review.service)
readonly review_unit="agent-runner-review.service"
readonly -a review_env_files=(/etc/agent-runner/runner-review.env /etc/agent-runner/review.env)
readonly default_review_state_dir="/var/lib/agent-runner-review/state"
readonly agent_host_binary="$current_link/agent-host"
readonly cli_root="/opt/agent-cli"
readonly cli_releases_root="$cli_root/releases"
readonly cli_current_link="$cli_root/current"
readonly npm_binary="/usr/bin/npm"
readonly codex_launcher="/usr/local/bin/codex"
readonly claude_launcher="/usr/local/bin/claude"
readonly provider_auth_file="/etc/agent-runner/provider-auth.env"
force_restart=0
review_guard_state_dir=""
review_guard_main_pid=""

die() {
  printf 'agent-runner-deploy: %s\n' "$*" >&2
  exit 2
}

# The busy-slot policy lives in the runner binary, not here, so the deploy
# script and the daemon cannot drift on what "busy" means.
review_state_dir() {
  local main_pid
  local environment_files
  local file
  local selected_file=""
  local value=""

  if systemctl is-active --quiet "$review_unit"; then
    main_pid="$(unit_main_pid "$review_unit")" || {
      printf 'agent-runner-deploy: could not resolve the active review MainPID\n' >&2
      return 1
    }
    [[ "$main_pid" =~ ^[1-9][0-9]*$ && -r "/proc/$main_pid/environ" ]] || {
      printf 'agent-runner-deploy: active review MainPID has no readable environment: %s\n' \
        "$main_pid" >&2
      return 1
    }
    value="$(read_process_environment_value "$main_pid" RUNNER_STATE_DIR)" || return 1
    value="$(strip_environment_quotes "$value")"
    validate_review_state_dir "$value" || return 1
    printf '%s\n' "$value"
    return 0
  fi

  environment_files="$(systemctl show --property=EnvironmentFiles --value "$review_unit" 2>/dev/null)" \
    || return 1
  while IFS= read -r file; do
    local approved_file
    for approved_file in "${review_env_files[@]}"; do
      if [[ "$file" == "$approved_file" ]]; then
        selected_file="$file"
        break
      fi
    done
  done < <(unit_environment_file_paths "$environment_files")
  if [[ -n "$selected_file" ]]; then
    [[ -f "$selected_file" && ! -L "$selected_file" ]] || return 1
    value="$(awk -F= '$1 == "RUNNER_STATE_DIR" { print substr($0, index($0, "=") + 1) }' "$selected_file" | tail -n 1)"
    if [[ -n "$value" ]]; then
      value="$(strip_environment_quotes "$value")"
      validate_review_state_dir "$value" || return 1
      printf '%s\n' "$value"
      return 0
    fi
  fi

  validate_review_state_dir "$default_review_state_dir" || return 1
  printf '%s\n' "$default_review_state_dir"
}

strip_environment_quotes() {
  local value="$1"
  if (( ${#value} >= 2 )); then
    if [[ "${value:0:1}" == '"' && "${value: -1}" == '"' ]] \
        || [[ "${value:0:1}" == "'" && "${value: -1}" == "'" ]]; then
      value="${value:1:${#value}-2}"
    fi
  fi
  printf '%s\n' "$value"
}

validate_review_state_dir() {
  local value="$1"
  [[ -n "$value" && "$value" == /* && "$value" != "/" && "$value" != *$'\n'* ]] || {
    printf 'agent-runner-deploy: invalid effective RUNNER_STATE_DIR: %q\n' "$value" >&2
    return 1
  }
}

# Refuses a restart that would discard running review gate work. A review
# takes tens of minutes, so the sanctioned path is a drain; --force stays
# available for a root operator who requires an immediate lease handoff.
assert_review_restart_is_safe() {
  local guard_binary="${1:-$agent_host_binary}"
  local guard_status=0
  local main_pid_after_state
  local state_dir

  if ((force_restart)); then
    printf 'agent-runner-deploy: --force given; skipping the review restart guard\n' >&2
    return 0
  fi
  if ! systemctl is-active --quiet "$review_unit"; then
    return 0
  fi
  [[ -x "$guard_binary" ]] \
    || die "review restart guard is unavailable because agent-host is not executable: $guard_binary"
  review_guard_main_pid="$(unit_main_pid "$review_unit")" \
    || die "could not resolve the active review daemon MainPID"
  [[ "$review_guard_main_pid" =~ ^[1-9][0-9]*$ ]] \
    || die "active review daemon returned an invalid MainPID"
  state_dir="$(review_state_dir)" \
    || die "could not resolve the active review daemon's effective RUNNER_STATE_DIR"
  main_pid_after_state="$(unit_main_pid "$review_unit")" \
    || die "could not recheck the active review daemon MainPID"
  [[ "$main_pid_after_state" == "$review_guard_main_pid" ]] \
    || die "review MainPID changed while resolving its state directory; retry the guarded operation"
  review_guard_state_dir="$state_dir"

  env -i PATH="$PATH" \
    "$guard_binary" --restart-guard --hold-admission --role review --state-dir "$state_dir" \
    || guard_status="$?"
  if ((guard_status == 0)); then
    main_pid_after_state="$(unit_main_pid "$review_unit")" \
      || die "could not verify the guarded review daemon MainPID"
    [[ "$main_pid_after_state" == "$review_guard_main_pid" ]] \
      || die "review MainPID changed before guarded replacement; admission remains closed"
  fi
  case "$guard_status" in
    0) return 0 ;;
    3)
      logger -p authpriv.notice -t agent-runner-deploy \
        "action=restart-guard unit=$review_unit result=refused" || true
      die "refusing to restart $review_unit because slots are busy or the live daemon did not acknowledge closed admission. Run 'agent-runner-deploy drain' first. For the one-time pre-control-protocol upgrade, retire Review admission, verify zero active slots, then use the command's --force form as root."
      ;;
    *)
      die "review restart guard failed with exit $guard_status"
      ;;
  esac
}

# Stop claiming, let the running reviews finish, then leave Review stopped.
# Restart=on-failure distinguishes this successful operator drain from a crash.
drain_review_unit() {
  local drain_status=0
  local drain_result
  local previous_main_pid
  local state_dir

  [[ -x "$agent_host_binary" ]] || die "agent-host is not executable: $agent_host_binary"
  systemctl is-active --quiet "$review_unit" \
    || die "$review_unit is not running; there is nothing to drain"
  previous_main_pid="$(unit_main_pid "$review_unit")" \
    || die "could not query the review unit MainPID before drain: $review_unit"
  [[ "$previous_main_pid" =~ ^[1-9][0-9]*$ ]] \
    || die "review unit returned an invalid MainPID before drain: $review_unit"
  state_dir="$(review_state_dir)" \
    || die "could not resolve the active review daemon's effective RUNNER_STATE_DIR"

  env -i PATH="$PATH" \
    "$agent_host_binary" --drain --role review --state-dir "$state_dir" \
    || drain_status="$?"
  if ((drain_status == 0)); then drain_result="drained"; else drain_result="incomplete"; fi
  logger -p authpriv.notice -t agent-runner-deploy \
    "action=drain unit=$review_unit result=$drain_result exit=$drain_status" || true
  ((drain_status == 0)) || die "review drain did not complete (exit $drain_status)"
  wait_for_unit_inactive "$review_unit" "$main_pid_wait_seconds" \
    || die "review drain was acknowledged, but $review_unit did not stop"
  logger -p authpriv.notice -t agent-runner-deploy \
    "action=drain unit=$review_unit result=stopped previousPid=$previous_main_pid" || true
  printf 'agent-runner-deploy: %s drained and stopped (previous MainPID %s)\n' \
    "$review_unit" "$previous_main_pid"
}

audit_config() {
  local result="$1"
  local detail="$2"

  logger -p authpriv.notice -t agent-runner-deploy \
    "action=config role=$config_role variable=$AGENT_RUNNER_CONFIG_VARIABLE old=$old_value new=$AGENT_RUNNER_CONFIG_VALUE unit=$AGENT_RUNNER_CONFIG_UNIT result=$result detail=$detail"
}

unit_loads_environment_file() {
  local environment_files="$1"
  local expected_path="$2"

  unit_environment_file_paths "$environment_files" | grep -Fxq -- "$expected_path"
}

unit_environment_file_paths() {
  local environment_files="$1"

  awk '
    {
      for (field_index = 1; field_index <= NF; field_index++) {
        if ($field_index ~ /^\(/) continue
        value = $field_index
        sub(/^-/, "", value)
        print value
      }
    }
  ' <<<"$environment_files"
}

read_process_environment_value() {
  local main_pid="$1"
  local variable="$2"

  tr '\0' '\n' <"/proc/$main_pid/environ" \
    | awk -F= -v key="$variable" '$1 == key { print substr($0, index($0, "=") + 1) }'
}

wait_for_new_main_pid() {
  local unit="$1"
  local previous_main_pid="$2"
  local timeout_seconds="${3:-$main_pid_wait_seconds}"
  local deadline=$((SECONDS + timeout_seconds))
  local unit_state
  local active_state
  local observed_main_pid

  while true; do
    if unit_state="$(systemctl show --property=ActiveState --property=MainPID "$unit" 2>/dev/null)"; then
      active_state="$(awk -F= '$1 == "ActiveState" { print $2 }' <<<"$unit_state")"
      observed_main_pid="$(awk -F= '$1 == "MainPID" { print $2 }' <<<"$unit_state")"
      if [[ "$active_state" == "active" \
          && "$observed_main_pid" =~ ^[1-9][0-9]*$ \
          && "$observed_main_pid" != "$previous_main_pid" ]]; then
        printf '%s\n' "$observed_main_pid"
        return 0
      fi
    fi

    ((SECONDS < deadline)) || return 1
    sleep "$main_pid_poll_seconds"
  done
}

wait_for_unit_inactive() {
  local unit="$1"
  local timeout_seconds="${2:-$main_pid_wait_seconds}"
  local deadline=$((SECONDS + timeout_seconds))
  local unit_state
  local active_state
  local observed_main_pid

  while true; do
    if unit_state="$(systemctl show --property=ActiveState --property=MainPID "$unit" 2>/dev/null)"; then
      active_state="$(awk -F= '$1 == "ActiveState" { print $2 }' <<<"$unit_state")"
      observed_main_pid="$(awk -F= '$1 == "MainPID" { print $2 }' <<<"$unit_state")"
      if [[ "$active_state" != "active" \
          && "$active_state" != "activating" \
          && "$observed_main_pid" == "0" ]]; then
        return 0
      fi
    fi

    ((SECONDS < deadline)) || return 1
    sleep "$main_pid_poll_seconds"
  done
}

clear_review_drain_state() {
  local state_dir="${1:-}"
  if [[ -z "$state_dir" ]]; then
    state_dir="$(review_state_dir)" || return 1
  fi
  validate_review_state_dir "$state_dir" || return 1
  rm -f -- \
    "$state_dir/review-drain-requested.json" \
    "$state_dir/review-drain-acknowledged.json"
}

validate_cli_version() {
  [[ "$1" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]] \
    || die "CLI target version must be a full semantic version"
}

probe_staged_cli() {
  local prefix="$1"
  local binary="$2"
  local line=""
  local key=""
  local value=""
  local -a probe_environment=(
    "HOME=$(getent passwd "$service_user" | cut -d: -f6)"
    "PATH=$prefix/node_modules/.bin:$PATH"
  )
  shift 2
  if [[ -f "$provider_auth_file" && ! -L "$provider_auth_file" ]]; then
    while IFS= read -r line; do
      key="${line%%=*}"
      [[ "$key" == "CLAUDE_CODE_OAUTH_TOKEN" || "$key" == "ANTHROPIC_API_KEY" ]] || continue
      value="$(strip_environment_quotes "${line#*=}")"
      probe_environment+=("$key=$value")
    done <"$provider_auth_file"
  fi
  timeout --signal=TERM --kill-after=2s "${smoke_timeout_seconds}s" \
    runuser -u "$service_user" -- env -i \
      "${probe_environment[@]}" \
      "$prefix/node_modules/.bin/$binary" "$@" >/dev/null
}

# Install only the two product-owned agent CLI packages. npm writes into an
# immutable staging prefix; version, login, and model probes all run before the
# one symlink flip, so a failed install or probe leaves the previous release in
# place. The semantic-version arguments are independently constrained here and
# by the exact sudoers command shipped with each product release.
update_clis() {
  local codex_version="$1"
  local claude_version="$2"
  validate_cli_version "$codex_version"
  validate_cli_version "$claude_version"
  [[ -x "$npm_binary" ]] || die "npm is not executable: $npm_binary"

  local release_id="codex-$codex_version--claude-$claude_version"
  local release_root="$cli_releases_root/$release_id"
  local staging_root="$cli_releases_root/.staging.$release_id.$$"
  local previous_target=""
  local previous_review_main_pid="0"
  local previous_codex_link=""
  local previous_claude_link=""
  [[ ! -e "$release_root" ]] || die "CLI release already exists: $release_root"
  install -d -o root -g root -m 0755 "$cli_root" "$cli_releases_root"
  install -d -o root -g root -m 0755 "$staging_root"
  trap '[[ -z "${staging_root:-}" ]] || rm -rf --one-file-system -- "$staging_root"' EXIT

  "$npm_binary" install --prefix "$staging_root" --ignore-scripts=false --no-save -- \
    "@openai/codex@$codex_version" \
    "@anthropic-ai/claude-code@$claude_version"
  chown -R root:root "$staging_root"
  find "$staging_root" -type d -exec chmod a+rx {} +
  [[ -x "$staging_root/node_modules/.bin/codex" ]] || die "staged codex launcher is missing"
  [[ -x "$staging_root/node_modules/.bin/claude" ]] || die "staged claude launcher is missing"

  probe_staged_cli "$staging_root" codex --version
  probe_staged_cli "$staging_root" claude --version
  probe_staged_cli "$staging_root" codex login status
  probe_staged_cli "$staging_root" claude auth status
  probe_staged_cli "$staging_root" codex debug models
  probe_staged_cli "$staging_root" claude models
  assert_review_restart_is_safe "$agent_host_binary"
  previous_review_main_pid="$(unit_main_pid "$review_unit")" \
    || die "could not query the review unit MainPID before CLI activation"

  previous_target="$(readlink -f -- "$cli_current_link" 2>/dev/null || true)"
  if [[ -z "$previous_target" ]]; then
    [[ -L "$codex_launcher" && -L "$claude_launcher" ]] \
      || die "first managed CLI activation requires the existing npm launchers to be symbolic links"
    previous_codex_link="$(readlink -- "$codex_launcher")"
    previous_claude_link="$(readlink -- "$claude_launcher")"
  fi
  mv -- "$staging_root" "$release_root"
  trap - EXIT
  ln -sfnT "$release_root" "$cli_current_link"
  ln -sfnT "$cli_current_link/node_modules/.bin/codex" "$codex_launcher"
  ln -sfnT "$cli_current_link/node_modules/.bin/claude" "$claude_launcher"

  if ! systemctl restart agent-runner.service \
      || ! restart_unit_and_wait_for_new_main_pid \
          "$review_unit" "$previous_review_main_pid" >/dev/null; then
    if [[ -n "$previous_target" && -d "$previous_target" ]]; then
      ln -sfnT "$previous_target" "$cli_current_link"
    else
      rm -f -- "$cli_current_link"
      ln -sfnT "$previous_codex_link" "$codex_launcher"
      ln -sfnT "$previous_claude_link" "$claude_launcher"
    fi
    rm -rf --one-file-system -- "$release_root"
    systemctl restart agent-runner.service || true
    best_effort_replace_unit "$review_unit"
    die "CLI activation failed; the previous CLI release was restored"
  fi

  logger -p authpriv.notice -t agent-runner-deploy \
    "action=update-clis codex=$codex_version claude=$claude_version previous=${previous_target:-none} result=activated" || true
  printf 'agent-runner-deploy: updated codex to %s and claude to %s\n' \
    "$codex_version" "$claude_version"
}

# RefuseManualStop blocks systemctl stop/restart for Review. The sanctioned
# helper signals only the active daemon MainPID, waits for its successful exit,
# clears any completed drain request, and explicitly starts the replacement.
# KillMode=process leaves detached workers untouched.
replace_review_unit_and_wait_for_new_main_pid() {
  local unit="$1"
  local previous_main_pid="$2"
  local timeout_seconds="${3:-$main_pid_wait_seconds}"
  local unit_state
  local active_state
  local observed_main_pid
  local state_dir="${review_guard_state_dir:-}"
  local guarded_main_pid="${review_guard_main_pid:-}"

  unit_state="$(systemctl show --property=ActiveState --property=MainPID "$unit" 2>/dev/null)" \
    || return 10
  active_state="$(awk -F= '$1 == "ActiveState" { print $2 }' <<<"$unit_state")"
  observed_main_pid="$(awk -F= '$1 == "MainPID" { print $2 }' <<<"$unit_state")"
  [[ "$observed_main_pid" =~ ^[0-9]+$ ]] || return 10
  if [[ -n "$guarded_main_pid" && "$observed_main_pid" != "$guarded_main_pid" ]]; then
    return 10
  fi
  if [[ -z "$state_dir" ]]; then
    state_dir="$(review_state_dir)" || return 10
  fi

  if [[ "$active_state" == "active" && "$observed_main_pid" =~ ^[1-9][0-9]*$ ]]; then
    if ! systemctl kill --kill-whom=main --signal=SIGTERM "$unit" >/dev/null; then
      # The daemon can exit between the state query and the signal.
      unit_state="$(systemctl show --property=ActiveState --property=MainPID "$unit" 2>/dev/null)" \
        || return 10
      active_state="$(awk -F= '$1 == "ActiveState" { print $2 }' <<<"$unit_state")"
      observed_main_pid="$(awk -F= '$1 == "MainPID" { print $2 }' <<<"$unit_state")"
      [[ "$active_state" != "active" ]] || return 10
    fi
    wait_for_unit_inactive "$unit" "$timeout_seconds" || return 11
  elif [[ "$active_state" == "activating" ]]; then
    return 10
  fi

  clear_review_drain_state "$state_dir" || return 10
  review_guard_state_dir=""
  review_guard_main_pid=""
  # Start is safe while RefuseManualStop protects stop/restart.
  systemctl start "$unit" >/dev/null || return 10
  wait_for_new_main_pid "$unit" "$previous_main_pid" "$timeout_seconds" || return 11
}

restart_unit_and_wait_for_new_main_pid() {
  local unit="$1"
  local previous_main_pid="$2"
  local timeout_seconds="${3:-$main_pid_wait_seconds}"

  if [[ "$unit" == "$review_unit" ]]; then
    replace_review_unit_and_wait_for_new_main_pid \
      "$unit" "$previous_main_pid" "$timeout_seconds"
    return
  fi
  systemctl restart "$unit" >/dev/null || return 10
  wait_for_new_main_pid "$unit" "$previous_main_pid" "$timeout_seconds" || return 11
}

unit_main_pid() {
  local unit="$1"
  local main_pid

  main_pid="$(systemctl show --property=MainPID --value "$unit")" || return 1
  [[ "$main_pid" =~ ^[0-9]+$ ]] || return 1
  printf '%s\n' "$main_pid"
}

best_effort_replace_unit() {
  local unit="$1"
  local previous_main_pid="0"

  previous_main_pid="$(unit_main_pid "$unit")" || previous_main_pid="0"
  restart_unit_and_wait_for_new_main_pid \
    "$unit" "$previous_main_pid" >/dev/null 2>&1 || true
}

restart_review_unit() {
  local previous_main_pid
  local replacement_main_pid

  assert_review_restart_is_safe
  previous_main_pid="$(unit_main_pid "$review_unit")" \
    || die "could not query the review unit MainPID before replacement: $review_unit"
  replacement_main_pid="$(restart_unit_and_wait_for_new_main_pid \
    "$review_unit" "$previous_main_pid")" \
    || die "systemd did not start a replacement MainPID for $review_unit"
  logger -p authpriv.notice -t agent-runner-deploy \
    "action=restart-review unit=$review_unit previousPid=$previous_main_pid pid=$replacement_main_pid force=$force_restart result=replaced" || true
  printf 'agent-runner-deploy: replaced %s MainPID %s with %s\n' \
    "$review_unit" "$previous_main_pid" "$replacement_main_pid"
}

rollback_config() {
  local reason="$1"

  if [[ -n "${rollback_file:-}" && -f "$rollback_file" ]]; then
    mv -fT -- "$rollback_file" "$config_env_file"
    rollback_file=""
    best_effort_replace_unit "$AGENT_RUNNER_CONFIG_UNIT"
  fi
  audit_config "rolled-back" "$reason" || true
  die "configuration was rolled back: $reason"
}

configure_role() {
  config_role="$1"
  local requested_variable="$2"
  local requested_value="$3"

  [[ -f "$config_policy" && ! -L "$config_policy" ]] \
    || die "configuration policy is missing or invalid: $config_policy"
  [[ "$(stat -c '%U:%G:%a' "$config_policy")" == "root:root:755" ]] \
    || die "configuration policy must be root:root mode 0755"
  # shellcheck source=/dev/null
  source "$config_policy"
  agent_runner_resolve_config "$config_role" "$requested_variable" "$requested_value" \
    || die "configuration request was rejected"

  systemctl cat "$AGENT_RUNNER_CONFIG_UNIT" >/dev/null \
    || die "role unit is not installed: $AGENT_RUNNER_CONFIG_UNIT"
  local unit_environment_files
  unit_environment_files="$(systemctl show --property=EnvironmentFiles --value "$AGENT_RUNNER_CONFIG_UNIT")"
  # systemd applies EnvironmentFile values after Environment= values. A role
  # file such as runner-review.env therefore overrides the main unit's
  # RUNNER_MAX_PARALLELISM=2 default. The loaded-file check here establishes
  # the source, and the new-MainPID /proc check below proves the effective value.
  if [[ -f "$AGENT_RUNNER_CONFIG_PRIMARY_ENV" ]] \
      && unit_loads_environment_file "$unit_environment_files" "$AGENT_RUNNER_CONFIG_PRIMARY_ENV"; then
    config_env_file="$AGENT_RUNNER_CONFIG_PRIMARY_ENV"
  elif unit_loads_environment_file "$unit_environment_files" "$AGENT_RUNNER_CONFIG_FALLBACK_ENV"; then
    config_env_file="$AGENT_RUNNER_CONFIG_FALLBACK_ENV"
  else
    die "role unit does not load an approved EnvironmentFile: $AGENT_RUNNER_CONFIG_UNIT"
  fi

  [[ -f "$config_env_file" && ! -L "$config_env_file" ]] \
    || die "role EnvironmentFile is missing or invalid: $config_env_file"
  [[ "$(stat -c '%U:%G:%a' "$config_env_file")" == "root:$service_group:640" ]] \
    || die "role EnvironmentFile must be root:$service_group mode 0640: $config_env_file"

  local config_directory
  local candidate_file
  local existing_count
  config_directory="$(dirname "$config_env_file")"
  existing_count="$(awk -F= -v key="$AGENT_RUNNER_CONFIG_VARIABLE" '$1 == key { count++ } END { print count + 0 }' "$config_env_file")"
  ((existing_count <= 1)) \
    || die "role EnvironmentFile contains duplicate $AGENT_RUNNER_CONFIG_VARIABLE entries"
  old_value="$(awk -F= -v key="$AGENT_RUNNER_CONFIG_VARIABLE" '$1 == key { print substr($0, index($0, "=") + 1) }' "$config_env_file")"
  old_value="${old_value:-unset}"

  if [[ "$AGENT_RUNNER_CONFIG_UNIT" == "$review_unit" ]]; then
    assert_review_restart_is_safe
  fi

  local previous_main_pid
  if ! previous_main_pid="$(unit_main_pid "$AGENT_RUNNER_CONFIG_UNIT")"; then
    die "could not query the role unit MainPID before restart: $AGENT_RUNNER_CONFIG_UNIT"
  fi
  [[ "$previous_main_pid" =~ ^[0-9]+$ ]] \
    || die "role unit returned an invalid MainPID before restart: $AGENT_RUNNER_CONFIG_UNIT"

  candidate_file="$(mktemp "$config_directory/.agent-runner-config.candidate.XXXXXX")"
  rollback_file="$(mktemp "$config_directory/.agent-runner-config.rollback.XXXXXX")"
  trap 'rm -f -- "${candidate_file:-}" "${rollback_file:-}"' EXIT
  cp --preserve=mode,ownership,timestamps -- "$config_env_file" "$rollback_file"

  awk -v key="$AGENT_RUNNER_CONFIG_VARIABLE" -v value="$AGENT_RUNNER_CONFIG_VALUE" '
    BEGIN { replaced = 0 }
    index($0, key "=") == 1 {
      if (replaced == 0) {
        print key "=" value
        replaced = 1
      }
      next
    }
    { print }
    END {
      if (replaced == 0)
        print key "=" value
    }
  ' "$config_env_file" >"$candidate_file"
  chown root:"$service_group" "$candidate_file"
  chmod 0640 "$candidate_file"
  sync -f "$candidate_file"
  mv -fT -- "$candidate_file" "$config_env_file"
  candidate_file=""

  local main_pid
  local process_value
  local restart_result
  if main_pid="$(restart_unit_and_wait_for_new_main_pid \
      "$AGENT_RUNNER_CONFIG_UNIT" "$previous_main_pid")"; then
    restart_result=0
  else
    restart_result="$?"
  fi
  case "$restart_result" in
    0) ;;
    10) rollback_config "unit-restart-failed" ;;
    *) rollback_config "new-main-pid-timeout" ;;
  esac
  if ! process_value="$(read_process_environment_value \
      "$main_pid" "$AGENT_RUNNER_CONFIG_VARIABLE")"; then
    rollback_config "process-environment-read-failed"
  fi
  [[ "$process_value" == "$AGENT_RUNNER_CONFIG_VALUE" ]] \
    || rollback_config "process-environment-mismatch"

  if ! audit_config "applied" "pid=$main_pid"; then
    rollback_config "journal-write-failed"
  fi
  rm -f -- "$rollback_file"
  rollback_file=""
  trap - EXIT
  printf 'agent-runner-deploy: configured role=%s variable=%s value=%s unit=%s pid=%s\n' \
    "$config_role" \
    "$AGENT_RUNNER_CONFIG_VARIABLE" \
    "$AGENT_RUNNER_CONFIG_VALUE" \
    "$AGENT_RUNNER_CONFIG_UNIT" \
    "$main_pid"
}

current_release_id() {
  local target
  local release_id

  [[ -L "$current_link" ]] || return 1
  target="$(readlink -f -- "$current_link")" || return 1
  [[ "$(dirname -- "$target")" == "$releases_root" ]] || return 1
  release_id="$(basename -- "$target")"
  [[ "$release_id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || return 1
  printf '%s\n' "$release_id"
}

restart_count() {
  local unit="$1"
  local count

  count="$(systemctl show --property=NRestarts --value "$unit")" || return 1
  [[ "$count" =~ ^[0-9]+$ ]] || return 1
  printf '%s\n' "$count"
}

print_rollback_hint() {
  local previous_release_id="$1"

  if [[ -n "$previous_release_id" ]]; then
    printf 'agent-runner-deploy: previous release: %s\n' "$previous_release_id" >&2
    printf '%s\n' \
      "agent-runner-deploy: rollback command: sudo sh -c 'ln -sfnT $releases_root/$previous_release_id $current_link && /usr/local/sbin/agent-runner-deploy restart-review --force && systemctl restart agent-runner.service'" >&2
  else
    printf 'agent-runner-deploy: no previous release was available for rollback\n' >&2
  fi
}

post_restart_failure() {
  local release_id="$1"
  local previous_release_id="$2"
  local detail="$3"

  logger -p authpriv.notice -t agent-runner-deploy \
    "action=release release=$release_id previous=${previous_release_id:-none} result=post-restart-failed detail=$detail" || true
  print_rollback_hint "$previous_release_id"
  die "post-restart service check failed: $detail"
}

restart_release_services() {
  local release_id="$1"
  local previous_release_id="$2"
  shift 2
  local -a before_restart_counts=("$@")
  local -a replacement_order=(1 0)
  local -a observed_restart_counts=()
  local unit
  local unit_index
  local count
  local deadline
  local previous_main_pid
  local replacement_main_pid
  local restart_result
  local allowed_restart_increase

  # Replace Review first so it cannot claim new work during a potentially slow
  # Coding shutdown after the final busy-slot check.
  for unit_index in "${replacement_order[@]}"; do
    unit="${release_units[$unit_index]}"
    if ! previous_main_pid="$(unit_main_pid "$unit")"; then
      post_restart_failure "$release_id" "$previous_release_id" "main-pid-query-failed:$unit"
    fi
    if replacement_main_pid="$(restart_unit_and_wait_for_new_main_pid \
        "$unit" "$previous_main_pid")"; then
      restart_result=0
    else
      restart_result="$?"
    fi
    case "$restart_result" in
      0) ;;
      10) post_restart_failure "$release_id" "$previous_release_id" "unit-restart-failed:$unit" ;;
      *) post_restart_failure "$release_id" "$previous_release_id" "new-main-pid-timeout:$unit" ;;
    esac
    if [[ ! "$replacement_main_pid" =~ ^[1-9][0-9]*$ ]]; then
      post_restart_failure "$release_id" "$previous_release_id" "invalid-replacement-main-pid:$unit"
    fi
  done

  for unit_index in "${!release_units[@]}"; do
    unit="${release_units[$unit_index]}"
    if ! systemctl is-active --quiet "$unit"; then
      post_restart_failure "$release_id" "$previous_release_id" "unit-not-active:$unit"
    fi
    if ! count="$(restart_count "$unit")"; then
      post_restart_failure "$release_id" "$previous_release_id" "restart-counter-query-failed:$unit"
    fi
    allowed_restart_increase=0
    [[ "$unit" != "$review_unit" ]] || allowed_restart_increase=1
    if ((count > before_restart_counts[unit_index] + allowed_restart_increase)); then
      post_restart_failure "$release_id" "$previous_release_id" \
        "restart-counter-increased:$unit:${before_restart_counts[$unit_index]}->$count"
    fi
    observed_restart_counts+=("$count")
  done

  deadline=$((SECONDS + restart_observation_seconds))
  while ((SECONDS < deadline)); do
    sleep 1
    for unit_index in "${!release_units[@]}"; do
      unit="${release_units[$unit_index]}"
      if ! count="$(restart_count "$unit")"; then
        post_restart_failure "$release_id" "$previous_release_id" "restart-counter-query-failed:$unit"
      fi
      if [[ "$count" != "${observed_restart_counts[$unit_index]}" ]]; then
        post_restart_failure "$release_id" "$previous_release_id" \
          "restart-counter-changed:$unit:${observed_restart_counts[$unit_index]}->$count"
      fi
      if ! systemctl is-active --quiet "$unit"; then
        post_restart_failure "$release_id" "$previous_release_id" "unit-left-active-state:$unit"
      fi
    done
  done
}

promote_release() {
  command -v find >/dev/null || die "find is required"
  command -v readlink >/dev/null || die "readlink is required"
  command -v runuser >/dev/null || die "runuser is required"
  command -v systemctl >/dev/null || die "systemctl is required"
  command -v timeout >/dev/null || die "timeout is required"
  command -v dotnet >/dev/null || die "dotnet is required"
  [[ -x /usr/bin/python3 ]] || die "/usr/bin/python3 is required"
  id "$service_user" >/dev/null 2>&1 || die "service account '$service_user' does not exist"
  getent group "$service_group" >/dev/null || die "service group '$service_group' does not exist"
  [[ -f "$deps_closure_validator" && ! -L "$deps_closure_validator" && -x "$deps_closure_validator" ]] \
    || die "dependency closure validator is missing or invalid: $deps_closure_validator"
  [[ "$(stat -c '%U:%G:%a' "$deps_closure_validator")" == "root:root:755" ]] \
    || die "dependency closure validator must be root:root mode 0755"

  local dotnet_path
  local dotnet_root
  dotnet_path="$(readlink -f -- "$(command -v dotnet)")" \
    || die "could not resolve the dotnet host"
  [[ -x "$dotnet_path" ]] || die "resolved dotnet host is not executable: $dotnet_path"
  dotnet_root="$(dirname -- "$dotnet_path")"

  local previous_release_id=""
  previous_release_id="$(current_release_id || true)"
  local -a before_restart_counts=()
  local unit
  local count
  for unit in "${release_units[@]}"; do
    systemctl cat "$unit" >/dev/null || die "release unit is not installed: $unit"
    count="$(restart_count "$unit")" || die "could not read restart counter for $unit"
    before_restart_counts+=("$count")
  done

  install -d -o root -g root -m 0755 "$deploy_root" "$accepted_root" "$product_root" "$releases_root"
  [[ -d "$incoming_root" ]] || die "staged release is missing: $incoming_root"
  [[ ! -L "$incoming_root" ]] || die "staged release root must not be a symbolic link"
  [[ "$(stat -c '%U:%G' "$incoming_root")" == "$service_user:$service_group" ]] \
    || die "staged release must be owned by $service_user:$service_group"

  local invalid_entry
  invalid_entry="$(find "$incoming_root" -xdev -mindepth 1 ! -type d ! -type f -print -quit)"
  [[ -z "$invalid_entry" ]] || die "staged release contains a non-regular entry: $invalid_entry"

  local release_id_file="$incoming_root/release-id"
  local release_id
  [[ -f "$release_id_file" && ! -L "$release_id_file" ]] || die "release-id is missing or invalid"
  release_id="$(<"$release_id_file")"
  [[ "$release_id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] \
    || die "release-id must contain 1 to 64 safe characters"

  local required_file
  for required_file in agent-host agent-host.dll agent-host.deps.json agent-host.runtimeconfig.json; do
    [[ -f "$incoming_root/$required_file" && ! -L "$incoming_root/$required_file" ]] \
      || die "required release file is missing or invalid: $required_file"
  done
  [[ -x "$incoming_root/agent-host" ]] || die "agent-host is not executable"

  local deps_json_bytes
  deps_json_bytes="$(stat -c '%s' "$incoming_root/agent-host.deps.json")"
  [[ "$deps_json_bytes" =~ ^[0-9]+$ ]] || die "could not measure agent-host.deps.json"
  ((deps_json_bytes <= maximum_deps_json_bytes)) \
    || die "agent-host.deps.json exceeds the 16 MiB safety limit"

  local release_bytes
  release_bytes="$(du -sb "$incoming_root" | awk '{print $1}')"
  [[ "$release_bytes" =~ ^[0-9]+$ ]] || die "could not measure staged release"
  ((release_bytes <= maximum_release_bytes)) || die "staged release exceeds the 1 GiB safety limit"

  local release_root="$releases_root/$release_id"
  local accepted_release="$accepted_root/$release_id"
  [[ ! -e "$release_root" ]] || die "immutable release already exists: $release_root"
  [[ ! -e "$accepted_release" ]] || die "accepted upload already exists: $accepted_release"
  if [[ -e "$compatibility_link" && ! -L "$compatibility_link" ]]; then
    [[ ! -e "$legacy_backup" ]] || die "legacy compatibility backup already exists: $legacy_backup"
  fi

  local staging_root="$releases_root/.staging.$release_id.$$"
  trap 'rm -rf --one-file-system -- "$staging_root"' EXIT
  install -d -o root -g root -m 0755 "$staging_root"
  cp -R --no-preserve=all "$incoming_root/." "$staging_root/"
  rm -- "$staging_root/release-id"
  chown -R root:root "$staging_root"
  find "$staging_root" -type d -exec chmod 0755 {} +
  find "$staging_root" -type f -exec chmod 0644 {} +
  chmod 0755 "$staging_root/agent-host"

  local closure_output
  local closure_status
  if closure_output="$(
    "$deps_closure_validator" "$staging_root/agent-host.deps.json" "$staging_root" 2>&1
  )"; then
    :
  else
    closure_status=$?
    die "dependency closure validation failed (exit $closure_status): ${closure_output:-no detail}"
  fi

  local smoke_output
  local smoke_status
  if smoke_output="$(
    cd -- "$staging_root"
    timeout --signal=TERM --kill-after=2s "${smoke_timeout_seconds}s" \
      runuser -u "$service_user" -- \
      env -i \
        PATH="$PATH" \
        DOTNET_ROOT="$dotnet_root" \
        DOTNET_ROOT_X64="$dotnet_root" \
        ./agent-host --version 2>&1
  )"; then
    :
  else
    smoke_status=$?
    smoke_output="${smoke_output//$'\n'/; }"
    die "staged agent-host boot smoke check failed (exit $smoke_status): ${smoke_output:-no output}"
  fi

  # Refuse before any release path or upload ownership changes. A busy guard
  # must leave current and incoming exactly as the operator staged them.
  assert_review_restart_is_safe "$staging_root/agent-host"

  mv -- "$staging_root" "$release_root"
  trap - EXIT

  ln -sfnT "$release_root" "$current_link"
  chown -h root:root "$current_link"
  if [[ -e "$compatibility_link" && ! -L "$compatibility_link" ]]; then
    mv -- "$compatibility_link" "$legacy_backup"
  fi
  ln -sfnT "$current_link" "$compatibility_link"
  chown -h root:root "$compatibility_link"

  mv -- "$incoming_root" "$accepted_release"
  chown -R root:root "$accepted_release"
  install -d -o "$service_user" -g "$service_group" -m 0750 "$incoming_root"

  restart_release_services \
    "$release_id" \
    "$previous_release_id" \
    "${before_restart_counts[@]}"

  logger -p authpriv.notice -t agent-runner-deploy \
    "action=release release=$release_id previous=${previous_release_id:-none} source=$incoming_root target=$release_root result=activated" || true
  printf 'agent-runner-deploy: promoted and activated release %s at %s\n' "$release_id" "$release_root"
}

main() {
  [[ "$EUID" -eq 0 ]] || die "must run as root through the approved sudo rule"
  command -v flock >/dev/null || die "flock is required"
  command -v stat >/dev/null || die "stat is required"
  install -d -o root -g root -m 0755 "$deploy_root"
  exec 9>"$deploy_root/.deploy.lock"
  flock -n 9 || die "another release promotion or configuration update is already running"

  case "$#:${1:-}" in
    0:)
      promote_release
      ;;
    1:--force)
      force_restart=1
      promote_release
      ;;
    1:drain)
      drain_review_unit
      ;;
    1:restart-review)
      restart_review_unit
      ;;
    3:update-clis)
      update_clis "$2" "$3"
      ;;
    2:restart-review)
      [[ "$2" == "--force" ]] || die "unknown Review restart flag: $2"
      force_restart=1
      restart_review_unit
      ;;
    4:config)
      configure_role "$2" "$3" "$4"
      ;;
    5:config)
      [[ "$5" == "--force" ]] || die "unknown configuration flag: $5"
      force_restart=1
      configure_role "$2" "$3" "$4"
      ;;
    *)
      die "usage: agent-runner-deploy [--force] | drain | restart-review [--force] | update-clis <codex-version> <claude-version> | config <coding|review> RUNNER_MAX_PARALLELISM <1-6> [--force]"
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
