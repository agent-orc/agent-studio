# /etc/agent-host/work-container-launcher.env for /usr/local/sbin/agent-work-launcher.
# Owner root:root, mode 0644. Only these three keys are accepted.

# docker or podman (rootful). The service user is not in the runtime group.
RUNTIME=docker

# State that `agent-host zone-policy apply --execute` records. The launcher
# admits a work container only on a network of the applied, verified work zone.
ZONE_POLICY_STATE=/var/lib/agent-studio/zone-policy/applied.json

# Set when agent-host is a framework-dependent build, as for the deploy smoke.
# DOTNET_ROOT=/usr/lib/dotnet
