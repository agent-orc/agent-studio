{
    servers {
        trusted_proxies static 172.30.83.2
        trusted_proxies_strict
    }
}

:8080 {
    encode zstd gzip

    @health path /healthz
    handle @health {
        reverse_proxy api:5031 {
            header_up Host {$STUDIO_DOMAIN}
        }
    }

    @api path /api /api/* /hubs /hubs/*
    handle @api {
        reverse_proxy api:5031 {
            header_up X-Forwarded-Proto https
        }
    }

    handle {
        root * /srv/studio
        try_files {path} /index.html
        file_server
    }
}
