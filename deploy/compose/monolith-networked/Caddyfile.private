{
    # The edge's root file system is read-only. Browsers trust the local root by hand (studio-website.md).
    skip_install_trust
}

{$STUDIO_DOMAIN} {
    tls internal
    encode zstd gzip
    header {
        >Strict-Transport-Security "max-age=31536000; includeSubDomains"
        >X-Content-Type-Options nosniff
        >Referrer-Policy same-origin
        -Server
    }
    reverse_proxy frontend:8080 {
        header_up X-Forwarded-For {client_ip}
    }
}

{$QUALITY_DOMAIN} {
    tls internal
    encode zstd gzip
    header {
        >Strict-Transport-Security "max-age=31536000; includeSubDomains"
        >X-Content-Type-Options nosniff
        >Referrer-Policy same-origin
        -Server
    }
    reverse_proxy quality-studio:8080 {
        header_up X-Forwarded-For {client_ip}
    }
}
