# Cloudflare edge mode: the hostname is a proxied Cloudflare DNS record with
# SSL mode Full (strict). Only peers in cloudflare-ips.caddy count as proxies;
# their CF-Connecting-IP becomes the client address. Any other peer is refused
# unless STUDIO_CLOUDFLARE_ALLOW_DIRECT is true, in which case the peer
# itself is the client and its CF-Connecting-IP is ignored.
#
# A Cloudflare address alone does not prove the request came through this
# zone: any Cloudflare customer can point a hostname at this origin. With
# direct access off, the TLS handshake therefore also requires Cloudflare's
# Authenticated Origin Pulls client certificate (enable it in the zone under
# SSL/TLS > Origin Server). cloudflare-origin-pull-ca.pem is Cloudflare's
# public origin-pull CA.
{
    servers {
        import /etc/caddy/cloudflare-ips.caddy
        client_ip_headers CF-Connecting-IP
        trusted_proxies_strict
    }
}

(origin-direct-false) {
    tls {
        client_auth {
            mode require_and_verify
            trust_pool file /etc/caddy/cloudflare-origin-pull-ca.pem
        }
    }
}

(origin-direct-true) {
}

{$STUDIO_DOMAIN} {
    # Any other value than true or false has no snippet and stops Caddy.
    import origin-direct-{$STUDIO_CLOUDFLARE_ALLOW_DIRECT:false}
    encode zstd gzip
    header {
        >Strict-Transport-Security "max-age=31536000; includeSubDomains"
        >X-Content-Type-Options nosniff
        >Referrer-Policy same-origin
        -Server
    }

    @bypass {
        vars {http.vars.trusted_proxy} false
        not vars {env.STUDIO_CLOUDFLARE_ALLOW_DIRECT} true
    }
    respond @bypass "Direct origin access is disabled. Use the Cloudflare hostname." 403

    reverse_proxy frontend:8080 {
        header_up X-Forwarded-For {client_ip}
    }
}
