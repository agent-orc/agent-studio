# Control plane Compose environment. Copy to `.env` (or pass
# --env-file explicitly) next to compose.yaml and fill in every value.
# install-docker.sh / update-docker.sh write this file for you from prompts
# or non-interactive flags; hand-editing is only for a manual bootstrap.

# Released image tag; the same tag names the task-server and
# orchestrator-engine images published for this version.
CONTROL_PLANE_VERSION=0.0.0

# Override only for a private registry mirror or an offline build.
# TASK_SERVER_IMAGE=ghcr.io/agent-orc/agent-studio-task-server
# ORCHESTRATOR_ENGINE_IMAGE=ghcr.io/agent-orc/agent-studio-orchestrator-engine

# Runner identity minted at bootstrap. The target topology has exactly one
# Runner (agent-runner-01); additional Runners are enrolled afterward through
# the management API, not through this bootstrap variable.
CONTROL_PLANE_RUNNER_ID=agent-runner-01

# task-server-01's WireGuard interface address (wg0). The edge listens on
# this address and TCP 443 only; it must never be a public or wildcard
# address. See deploy/compose/control-plane/wireguard/.
WG_ADDRESS=10.60.0.1

# Private DNS name resolved only inside the WireGuard network, used as the
# Caddyfile site address and put in the pinned certificate.
CONTROL_PLANE_DOMAIN=task-server-01.wg.internal

# Absolute path to the Caddyfile the edge serves. The default is the
# self-signed leaf used for a first bootstrap and CI. Point this at
# Caddyfile.private-ca (and mount the corresponding cert/key secrets in a
# compose override) once a private CA issues a longer-lived leaf.
CONTROL_PLANE_CADDYFILE=./Caddyfile

# Directory holding studio.token / engine.token / runner.token, each mode
# 0600 and owned by the service user. install-docker.sh generates these.
CONTROL_PLANE_SECRETS_DIR=/etc/agent-orchestrator/secrets

# Off-host backup destination. This must already be a mounted remote
# filesystem (for example an sshfs or rclone mount unit) before the stack
# starts; Compose only bind-mounts the path, it does not create the remote
# mount.
CONTROL_PLANE_OFFHOST_BACKUP_PATH=/mnt/agent-orchestrator-offhost-backup

# Seconds between scheduled backups. The maximum planned recovery point is
# five minutes (see docs/operations/remote-task-server-local-studio.md);
# only lower this after a load and restore rehearsal confirms it does not
# disrupt lease renewal or completion.
BACKUP_INTERVAL_SECONDS=300

# Resource limits. Defaults match the plan's 2 vCPU / 4 GiB starting point
# with headroom for the host OS and Docker itself.
# TASK_SERVER_CPU_LIMIT=2
# TASK_SERVER_MEMORY_LIMIT=1g
# ENGINE_CPU_LIMIT=1
# ENGINE_MEMORY_LIMIT=512m
# BACKUP_CPU_LIMIT=1
# BACKUP_MEMORY_LIMIT=512m
# EDGE_CPU_LIMIT=1
# EDGE_MEMORY_LIMIT=256m
