# Bootstrap contract consumed by task-server.
LISTEN_URL=http://127.0.0.1:5071
STORE_PATH=/var/lib/agent-orchestrator
BACKUP_PATH=/var/lib/agent-orchestrator/backups
ARCHIVE_PATH=/var/lib/agent-orchestrator/archive
BACKUP_PATH_FULL=/var/lib/agent-orchestrator/backups/full
# Optional off-host S3-compatible archive. The JSON credential file contains
# {"accessKey":"...","secretKey":"..."} and must be mode 0640 or stricter.
ARCHIVE_S3_ENDPOINT=
ARCHIVE_S3_BUCKET=
ARCHIVE_S3_PREFIX=
ARCHIVE_S3_REGION=us-east-1
ARCHIVE_S3_CREDENTIALS_FILE=
ARCHIVE_S3_PATH_STYLE=false
ARCHIVE_S3_SERVER_SIDE_CHECKSUM=true
AUTH=bearer
STUDIO_AUTH_TOKEN_FILE=/etc/agent-orchestrator/studio.token
ENGINE_AUTH_TOKEN_FILE=/etc/agent-orchestrator/engine.token

# Operational defaults retained until lease policy moves into the store.
TaskServer__MinimumLeaseSeconds=30
TaskServer__MaximumLeaseSeconds=600
TaskServer__MaximumEventPayloadBytes=262144
# Deprecated compatibility only. Remove after existing installations migrate:
# TaskServer__RequireAuthentication=true
# TaskServer__StudioBearerToken=
# TaskServer__RunnerBearerToken=
