# Optional user unit: install under ~/.config/systemd/user.
[Unit]
Description=Agent Studio nightly develop full suite for %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h
EnvironmentFile=%h/.config/agent-studio/post-merge-%i.env
ExecStart=/opt/agent-host/current/agent-host post-merge-run --mode nightly
Nice=19
CPUSchedulingPolicy=batch
IOSchedulingClass=idle
TimeoutStartSec=12h
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=%h
