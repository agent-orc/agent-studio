# /etc/agent-runner/coverage-run.env for agent-coverage-run.service (AGT-3074).
# Dedicated clone, registered in Quality Studio with this exact root path.
COVERAGE_RUN_CHECKOUT=/var/lib/agent-runner/coverage/agent-studio
COVERAGE_RUN_BRANCH=develop
# Runner state directories whose claimed slots make the host busy (colon-separated).
# An unreadable directory counts as busy, so grant this user read access.
COVERAGE_RUN_STATE_DIRS=/var/lib/agent-runner/state:/var/lib/agent-runner-review/state
# Skip while the 1-minute load per core is above this value.
COVERAGE_RUN_MAX_LOAD_PER_CORE=0.5
COVERAGE_RUN_HISTORY=/var/lib/agent-runner/coverage-runs.jsonl
QUALITY_STUDIO_BASE_URL=http://127.0.0.1:5127
QUALITY_STUDIO_REPO_ID=agent-studio-coverage
# Hosted Quality Studio only:
# QUALITY_STUDIO_API_TOKEN=
# QUALITY_STUDIO_CLIENT_ID=
