# Install as /etc/agent-runner/post-merge-<instance>.env.
# One project and one dedicated clone per installed pair of timers.
POST_MERGE_PROJECT="Agent Studio"
POST_MERGE_CHECKOUT=/var/lib/agent-runner/post-merge/agent-studio
POST_MERGE_SERVER_URL=http://127.0.0.1:5030
# A Runner service credential, readable by agent-runner only.
POST_MERGE_TOKEN_FILE=/etc/agent-runner/post-merge.token
POST_MERGE_BRANCH=develop
POST_MERGE_REMOTE=origin
POST_MERGE_MAX_MERGES=6
POST_MERGE_WINDOW_MINUTES=30
POST_MERGE_FREE_SLOTS=2
POST_MERGE_STATE_DIRS=/var/lib/agent-runner/state:/var/lib/agent-runner-review/state
