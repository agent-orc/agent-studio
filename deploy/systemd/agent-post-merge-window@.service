[Unit]
Description=Agent Studio develop merge-window check for %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=agent-runner
Group=agent-runner
WorkingDirectory=/var/lib/agent-runner
EnvironmentFile=/etc/agent-runner/post-merge-%i.env
ExecStart=/opt/agent-host/current/agent-host post-merge-run --mode window
Nice=19
CPUSchedulingPolicy=batch
IOSchedulingClass=idle
TimeoutStartSec=3h
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/agent-runner /home/agent-runner
