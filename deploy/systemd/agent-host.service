# Legacy static reference for unmanaged/manual deployments.
# Managed Linux hosts use remote-runner-onboard.sh, which renders host-derived
# CPUQuota, CPUWeight, IOWeight, and optional MemoryMax into the main unit.
[Unit]
Description=Agent Studio agent host daemon
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=agent-runner
Group=agent-runner
WorkingDirectory=/var/lib/agent-runner
EnvironmentFile=/etc/agent-runner/runner.env
# Shared, root-owned provider credentials. Keep this entry after runner.env so
# provider-auth values win over accidental legacy Environment= declarations.
EnvironmentFile=/etc/agent-runner/provider-auth.env
# Keep the host-owned Mode-A Studio stack available for headless UI and
# screenshot tasks. A missing script is non-fatal for non-UI hosts.
ExecStartPre=-/home/agent-runner/bin/stack-start.sh
ExecStart=/opt/agent-host/current/agent-host --poll
Restart=always
RestartSec=10s
TimeoutStopSec=90s
KillSignal=SIGTERM
# Stop only the daemon main PID. Detached job workers stay alive and are
# positively verified + reattached by the replacement daemon.
KillMode=process
SyslogIdentifier=agent-host
StandardOutput=journal
StandardError=journal

NoNewPrivileges=true
# PrivateTmp=true tears the unit's private /tmp mount away on every daemon
# restart, including from underneath a detached job worker that
# KillMode=process deliberately left running. See scripts/remote-runner-onboard.sh
# for the incident detail (MSB1025 / SocketException (99) / mkdtemp ENOENT).
PrivateTmp=false
ProtectSystem=full
ReadWritePaths=/var/lib/agent-runner /home/agent-runner

[Install]
WantedBy=multi-user.target
Alias=agent-runner.service
