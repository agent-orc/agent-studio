# The bootstrap copies this template to git-ignored `.env`.
# `docker compose` reads `.env` from the project directory automatically;
# run scripts/compose-distributed-bootstrap.sh before `docker compose up --wait`.

# Version for source builds from this checkout.
AGENT_STUDIO_VERSION=0.9.2

# One compatible published-image tag for every service. Set this to a verified
# v<version> only after this one-box code is released. "unpublished" makes an
# accidental pull fail closed while source builds remain the interim path.
AGENT_STUDIO_IMAGE_TAG=unpublished

# Host ports. UI and service diagnostic ports bind 127.0.0.1 only.
STUDIO_UI_PORT=4011
STUDIO_API_PORT=5031
STUDIO_TASKSERVER_PORT=5071
STUDIO_BFF_PORT=5072

# Bearer credentials for Task Server's Studio, Engine, coding and review
# principals. Run
# scripts/compose-distributed-bootstrap.sh instead of filling these in by
# hand: it generates independent 256-bit values here and never overwrites one
# you already set. See docs/operations/setup/getting-started.md.
DISTRIBUTED_STUDIO_TOKEN=
DISTRIBUTED_ENGINE_TOKEN=
DISTRIBUTED_RUNNER_TOKEN=
DISTRIBUTED_REVIEW_RUNNER_TOKEN=

# Exact browser Origin values accepted by the BFF. Keep loopback for the
# default edge. LAN access requires a separate HTTPS edge and its exact origin.
STUDIO_ALLOWED_ORIGINS=http://127.0.0.1:4011,http://localhost:4011

# Legacy compatibility API only. The one-box default does not start it.
TASK_SERVER_BASE_URL=

# Standalone authority data lives in orchestrator-data. There are no host
# data paths here.
