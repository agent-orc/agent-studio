# Copy to `.env` (git-ignored) to override the docker-compose.yml defaults.
# `docker compose` reads `.env` from the project directory automatically;
# nothing here is required for `docker compose up --wait` to work.

# Release image tag pulled by every non-dev service below. "latest" tracks
# the most recent published tag; pin an exact release for reproducibility,
# e.g. AGENT_STUDIO_VERSION=1.4.0.
AGENT_STUDIO_VERSION=latest

# Host ports. All API/Task-Server/BFF ports bind 127.0.0.1 only; the UI port
# is the one port meant to be reached from another machine on your network.
STUDIO_UI_PORT=4011
STUDIO_API_PORT=5031
STUDIO_TASKSERVER_PORT=5071
STUDIO_BFF_PORT=5072

# --profile distributed only: bearer credentials for the Task Server's
# bootstrap Studio, Engine, and Runner principals. Run
# scripts/compose-distributed-bootstrap.sh instead of filling these in by
# hand: it generates independent 256-bit values here and never overwrites one
# you already set. See docs/operations/setup/getting-started.md#distributed-profile.
DISTRIBUTED_STUDIO_TOKEN=
DISTRIBUTED_ENGINE_TOKEN=
DISTRIBUTED_RUNNER_TOKEN=

# --profile distributed only: set by the compose-smoke-test.sh distributed
# run to point OrchestratorApi's /api/v1 at the Task Server as a transparent
# proxy. Leave blank for the default (local, non-distributed) profile.
TASK_SERVER_BASE_URL=

# Task data and project checkouts live in the named volumes declared in
# docker-compose.yml (workspace, projects, orchestrator-data, runner-coding,
# runner-review); there are no host bind-mount paths to configure here.
