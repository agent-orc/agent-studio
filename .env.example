# Copy this file to .env before starting. No secret is stored here.
# Pin a published release tag for reproducible upgrades. All product images
# use this same version; "latest" follows the latest release.
AGENT_STUDIO_VERSION=latest

# The UI and optional TLS edge bind only to local loopback by default.
# Set the bind address to a specific private interface to expose the service.
STUDIO_UI_BIND_ADDRESS=127.0.0.1
STUDIO_UI_PORT=4011
STUDIO_API_PORT=5031
STUDIO_TASKSERVER_PORT=5071
STUDIO_BFF_PORT=5072
STUDIO_EDGE_BIND_ADDRESS=127.0.0.1
STUDIO_EDGE_PORT=8443
STUDIO_EDGE_HOSTNAME=localhost

# Optional Agent Host settings. Internal principal credentials are created in
# the credentials Docker volume. Supply provider and Git credentials via the
# two read-only directory mounts, then configure the repository URL here.
# The default runner registers without these values but cannot execute tasks
# until a CLI login and repository access are available.
RUNNER_GIT_REMOTE=
RUNNER_GIT_PUSH_REMOTE=
RUNNER_CLI_BIN=
RUNNER_CREDENTIALS_DIR=./.runner-credentials
RUNNER_GIT_CREDENTIALS_DIR=./.runner-git

# Migration only: an existing distributed-profile .env may already contain
# these. The bootstrap imports them once into the private credentials volume.
# Leave blank for a new install; Compose generates all principal secrets.
DISTRIBUTED_STUDIO_TOKEN=
DISTRIBUTED_ENGINE_TOKEN=
DISTRIBUTED_RUNNER_TOKEN=
