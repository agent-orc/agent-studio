# Copy to .env for a reproducible Compose install. Leave credential values out
# of this file; the bootstrap service creates them in a persistent named volume.
# Release image tags are v<AGENT_STUDIO_VERSION>. Update this value to upgrade.
AGENT_STUDIO_VERSION=0.9.2

# The HTTP browser UI is always bound to loopback. The optional edge profile
# provides the explicit private HTTPS listener for LAN access.
STUDIO_UI_PORT=4011
STUDIO_TASKSERVER_PORT=5071
STUDIO_BFF_PORT=5072
STUDIO_ALLOWED_ORIGINS=http://127.0.0.1:4011,http://localhost:4011

# Optional edge profile: Caddy issues and retains a local CA certificate.
# LAN clients must trust that CA or use their own trusted TLS terminator.
CADDY_VERSION=2.10-alpine
STUDIO_EDGE_BIND=127.0.0.1
STUDIO_EDGE_PORT=8443
STUDIO_EDGE_HOSTNAME=localhost

# Git remotes for tasks run by the included agent host. Leave blank until a
# project is configured. No Git or provider credential is needed to boot.
RUNNER_GIT_REMOTE=
RUNNER_GIT_PUSH_REMOTE=

# Optional host credential mounts. Coding and Review default to separate
# private writable named volumes for CLI-owned login refresh. Set any of these
# to an absolute host path only when that path is explicitly managed and
# protected by that runner service owner. Review has independent overrides.
# RUNNER_CLAUDE_CREDENTIALS_DIR=
# RUNNER_CODEX_CREDENTIALS_DIR=
# RUNNER_GEMINI_CREDENTIALS_DIR=
# REVIEW_RUNNER_CLAUDE_CREDENTIALS_DIR=
# REVIEW_RUNNER_CODEX_CREDENTIALS_DIR=
# REVIEW_RUNNER_GEMINI_CREDENTIALS_DIR=
# For Git over SSH, mount .ssh; for HTTPS, mount a Git credential-store file.
RUNNER_SSH_CREDENTIALS_DIR=./deploy/compose/empty-credentials
RUNNER_GIT_CREDENTIALS_FILE=./deploy/compose/empty-credentials/git-credentials
# REVIEW_RUNNER_SSH_CREDENTIALS_DIR=
# REVIEW_RUNNER_GIT_CREDENTIALS_FILE=
