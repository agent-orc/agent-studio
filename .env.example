# Agent Studio Docker Compose configuration.
#
#   cp .env.example .env
#
# Compose reads .env automatically. Every value below is optional and shown with
# the default the stack uses when the variable is absent, except
# AGENT_STUDIO_TASKSERVER_TOKEN, which has no usable default.
# .env is machine-local: never commit it and never let it reach a build context.

# --- Image selection -------------------------------------------------------
# The tag published by the release workflow for every service image. It must
# match a released tag; the workflow publishes v<version> and sha-<short>.
AGENT_STUDIO_VERSION=v0.1.0

# Registry namespace holding agent-studio-api, agent-studio-web,
# agent-task-server, agent-orchestrator-engine, agent-studio-bff, and agent-host.
AGENT_STUDIO_REGISTRY=ghcr.io/agent-orc

# Only read by `docker compose --profile dev build`. VERSION is stamped into the
# OCI image labels and must equal the repository VERSION file when set; REVISION
# is the commit that `--version` reports, because .dockerignore excludes .git.
AGENT_STUDIO_IMAGE_VERSION=
AGENT_STUDIO_IMAGE_REVISION=unknown

# --- Ports -----------------------------------------------------------------
# Host port for the Studio UI. Published on all interfaces.
STUDIO_UI_PORT=4011

# Host port for the orchestrator API. Published on loopback only.
STUDIO_API_PORT=5031

# Host port for the Task Server (--profile distributed). Loopback only.
STUDIO_TASKSERVER_PORT=5071

# Host port for the Studio BFF (--profile distributed). Loopback only.
STUDIO_BFF_PORT=5072

# --- Distributed profile ---------------------------------------------------
# Task Server bearer credential, at least 32 characters. Required by
# --profile distributed: the container's LISTEN_URL is not loopback, so the
# server refuses AUTH=none. The Engine, the Studio BFF, and the OrchestratorApi
# proxy all authenticate with this same value. Generate one with
# `openssl rand -hex 32` and keep it out of shell history and logs.
AGENT_STUDIO_TASKSERVER_TOKEN=

# Turns OrchestratorApi into a transparent /api/v1 proxy in front of the
# standalone Task Server. Blank keeps the local monolith profile.
AGENT_STUDIO_TASKSERVER_BASEURL=

# --- Runner profile --------------------------------------------------------
# Control plane the agent-hosts register against. Point this at
# http://task-server:5071 to run the agent-hosts against the standalone
# Task Server instead of the monolith.
AGENT_STUDIO_RUNNER_SERVER_URL=http://orchestrator-api:5031

# Host paths for the two files `scripts/compose-runner-bootstrap.sh` creates.
# Both stay outside every build context and are never committed.
AGENT_STUDIO_RUNNER_ENV_FILE=./runner.env
AGENT_STUDIO_RUNNER_TOKEN_FILE=./runner.token
