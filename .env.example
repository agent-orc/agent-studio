# Release image tag. Use a release tag such as v0.1.0 or an immutable sha-<short> tag.
AGENT_STUDIO_VERSION=v0.1.0

# Published host ports.
STUDIO_UI_PORT=4011
STUDIO_API_PORT=5031
STUDIO_PROXY_API_PORT=5032
STUDIO_TASKSERVER_PORT=5071
STUDIO_BFF_PORT=5072

# Persistent host paths. Create them before startup; on native Linux they must
# be writable by the image runtime account (UID/GID 10001).
STUDIO_WORKSPACE_PATH=./.data/workspace
STUDIO_PROJECTS_PATH=./.data/projects
TASK_SERVER_DATA_PATH=./.data/task-server
RUNNER_STATE_PATH=./.data/agent-host

# Replace this local example before exposing any service. Minimum 32 characters.
TASK_SERVER_AUTH_TOKEN=replace-with-at-least-32-random-characters

# Task Server limits from deploy/release/agent-orchestrator/config/server.env.template.
TASK_SERVER_MINIMUM_LEASE_SECONDS=30
TASK_SERVER_MAXIMUM_LEASE_SECONDS=600
TASK_SERVER_MAXIMUM_EVENT_PAYLOAD_BYTES=262144

# Orchestrator Engine settings from deploy/release/agent-orchestrator/config/engine.env.template.
ORCHESTRATOR_ENGINE_CLIENT_ID=orchestrator-engine
ORCHESTRATOR_REVIEW_CONCURRENCY=4
ORCHESTRATOR_COUNCIL_CONCURRENCY=4
ORCHESTRATOR_POST_PROCESSING_CONCURRENCY=3
ORCHESTRATOR_GATE_DISPATCH_CONCURRENCY=2
ORCHESTRATOR_COMPLETION_JUDGE_CONCURRENCY=4
ORCHESTRATOR_POLL_SECONDS=2
ORCHESTRATOR_LEASE_SECONDS=120

# Agent Host settings from deploy/release/agent-host/runner.env.template.
RUNNER_GIT_REMOTE=https://github.com/example/project.git
RUNNER_GIT_PUSH_REMOTE=https://github.com/example/project.git
RUNNER_MAX_PARALLELISM=1
RUNNER_CLI_BIN=claude

# Per-container json-file retention.
CONTAINER_LOG_MAX_SIZE=10m
CONTAINER_LOG_MAX_FILES=3
