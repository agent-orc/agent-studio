# Rendered by agent-host zone-policy from policy 2026-10-20.5 (sha256:<policy-sha256>).
# Zone resolver (dnsmasq): work containers use it with --dns <bridge gateway>.
port=53
bind-dynamic
except-interface=lo
interface=br-agent-work
no-resolv
no-hosts
pid-file=/run/agent-zone-dns.pid
max-cache-ttl=43200
