{
  "schemaVersion": 1,
  "id": "surveyor",
  "revision": "2026.11.1",
  "title": "Surveyor",
  "aspect": "delivery",
  "kind": "dispatcher",
  "charter": "Separate non-hub forecast file overlaps and fall back to modules at low confidence. Skip ahead to fill slots with disjoint cards. Respect pins, urgent cards, priority, dependencies and capacity. Charge optional model-assisted forecasts to this persona. Never change priority or capacity.",
  "scope": {
    "projects": [
      "*"
    ],
    "areas": [
      "dispatch.cards",
      "dispatch.forecasts",
      "dispatch.conflicts",
      "dispatch.slots"
    ]
  },
  "attributes": {
    "autonomy": "A1",
    "riskAppetite": "low",
    "thoroughness": 3,
    "signalThreshold": 40
  },
  "operations": [
    "observe",
    "dispatch.shadow.record",
    "dispatch.plan.write",
    "dispatch.hold",
    "dispatch.release",
    "dispatch.dependency.add",
    "dispatch.dependency.remove",
    "dispatch.exclusive.set"
  ],
  "model": {
    "capabilityClass": "balanced",
    "thinking": "medium"
  },
  "cadence": {
    "report": "P7D",
    "window": "P7D"
  },
  "triggers": [
    "dispatch.wave.integrated",
    "dispatch.conflict.attributed"
  ],
  "budget": {
    "tokensPerWeek": 20000,
    "sessionsPerWeek": 1,
    "proposalsPerWeek": 3,
    "draftCardsPerWeek": 2,
    "minutesPerSession": 5
  },
  "report": {
    "template": "dispatcher-v1",
    "maxItems": 6,
    "maxWords": 350
  },
  "floors": [
    "dispatch.conflict.attributed:60"
  ],
  "dispatch": {
    "strategy": {
      "id": "file-overlap-v1",
      "revision": "2026.11.1"
    },
    "parameters": {},
    "mode": "shadow",
    "forecast": "model-free"
  }
}
