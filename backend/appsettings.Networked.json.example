{
  "Urls": "http://127.0.0.1:5030",
  "Security": {
    "Profile": "networked",
    "MaxRequestBodyBytes": 26214400,
    "Session": {
      "IdleMinutes": 480,
      "AbsoluteMinutes": 10080
    },
    "LoginThrottle": {
      "ClientMaxFailures": 10,
      "UsernameMaxFailures": 20,
      "WindowMinutes": 15,
      "ClientLockoutMinutes": 15,
      "UsernameDelaySeconds": 2,
      "RecentSuccessMinutes": 1440
    }
  },
  "ErrorHandling": {
    "IncludeExceptionDetails": false
  },
  "WikiPublication": {
    "Enabled": true,
    "Remote": "origin",
    "IntervalSeconds": 120,
    "SnapshotRetention": 3,
    "AcceptedRefs": [ "main", "develop", "release/*" ]
  },
  "AllowedHosts": "tasks.example.com"
}
