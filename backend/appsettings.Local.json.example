{
  "//Purpose": "Per-checkout local override. This file is gitignored; copy it to appsettings.Local.json and edit. Loaded after appsettings.Development.json so flags here win on the developer's machine.",

  "Environment": {
    "//IsDev": "Renders the orange DEV stripe + orange PWA icon + (DEV) window title. Set true on the dev checkout, false (or omit the block) on the stable checkout.",
    "IsDev": true
  },

  "//Runner": "ADR-0044: per-backend pickup role. When unset, the role is inferred from Environment.IsDev (dev = test-subject, anything else = orchestrator). Set Role explicitly to override: 'orchestrator' runs the auto-pickup loop and is the stable seat; 'test-subject' suppresses the auto-pickup tick entirely so the dev backend can be observed by Playwright specs without racing stable on the shared workspace. BackendName labels the on-disk pickup lock so dev/stable show up as distinct owners.",
  "Runner": {
    "Role": "test-subject",
    "BackendName": "dev"
  },

  "//RunnerLinks": "Stable configuration. Keep this array empty in dev. The SSH alias and key remain in the service account's ~/.ssh directory.",
  "RunnerLinks": [
    {
      "RunnerId": "agent-runner-01",
      "Kind": "ssh-reverse",
      "SshTarget": "agent-runner",
      "RemotePort": 15031,
      "LocalPort": 5031,
      "ExtraForwards": [
        "5031:127.0.0.1:5031",
        "4011:localhost:4011"
      ],
      "HeartbeatTimeoutSeconds": 90,
      "BackoffSeconds": [5, 10, 30, 60, 120]
    }
  ],

  "DevTools": {
    "//comment": "Devtools knobs are dev-only conveniences. Leave them off on stable.",
    "UpdateStableEnabled": true,
    "DeleteE2EJobsEnabled": true
  },

  "//TaskRepository": "Workspace root. Job folders live under <TaskRepository>/projects/<projectKey>/tasks/<bucket>/<KEY>/. The registry metadata also lives here under <TaskRepository>/.metadata/{workspaces.json,projects.json} (ADR-0042).",
  "//TaskRepository.dev-vs-stable": "ADR-0056: the dev checkout points at its OWN slim demo store, NOT the heavy production workspace. STABLE keeps the production root below. DEV: set this to C:\\Projects\\agent-taskboard-workspace-demo and seed it once with `node scripts/seed-demo-workspace.mjs` (re-run any time to reset to a clean, deterministic demo stand). A separate demo store keeps dev start/memory slim and lets dev run in parallel with stable (no shared-workspace race; see ADR-0044).",
  "TaskRepository": "C:\\Projects\\agent-taskboard-workspace",

  "//TaskServer": "Stable production topology: configure BaseUrl only after the standalone Task Server has imported the frozen legacy store and /readyz is green. The updater verifies this value and refuses a decoupled rollout without it.",
  "TaskServer": {
    "BaseUrl": "http://127.0.0.1:5071"
  },

  "//WatchPaths": "ADR-0042: BOOTSTRAP discovery source only - ignored after first run for any RootPath that already has a registry record. Each entry seeds a project record on first boot. After the registry record exists, this entry can be removed without losing the project, and renaming Name here will not propagate to the registry's DisplayName. Use the (forthcoming F45b) /api/projects mutation endpoints to rename, archive, reassign workspace, or change color. Removing an entry here does NOT delete its registry record.",
  "//WatchPaths.dev-demo": "ADR-0056: on the DEV checkout, after `node scripts/seed-demo-workspace.mjs`, point WatchPaths at the seeded demo project folders via an explicit `Path` (the scanner reads <Path>/tasks/<bucket>/<KEY>/). The block below is the STABLE / real-repo pattern (RootPath = CLI working dir, resolved to <TaskRepository>/projects/<projectKey> via a .orchestrator.yml pointer). DEV example instead: [ { \"Name\": \"Demo App\", \"Path\": \"C:\\\\Projects\\\\agent-taskboard-workspace-demo\\\\projects\\\\demo-app\", \"RootPath\": \"C:\\\\Projects\\\\agent-taskboard-workspace-demo\\\\projects\\\\demo-app\" }, { \"Name\": \"Demo Platform\", \"Path\": \"C:\\\\Projects\\\\agent-taskboard-workspace-demo\\\\projects\\\\demo-platform\", \"RootPath\": \"C:\\\\Projects\\\\agent-taskboard-workspace-demo\\\\projects\\\\demo-platform\" } ]. RootPath is required as well as Path: the seeded Wiki tree and Dossier gallery live in <RootPath>/docs, and without it no repository root resolves and both surfaces stay empty.",
  "WatchPaths": [
    {
      "//comment": "RootPath is the working directory for CLI runs. RepositoryPath is optional; set it when git operations should run from a parent folder of RootPath.",
      "Name": "My Project",
      "RootPath": "C:\\Projects\\my-project\\App",
      "RepositoryPath": "C:\\Projects\\my-project"
    }
  ],

  "Supervisor": {
    "HardCheckEnabled": true
  }
}
