frontend/build_log.txt
.api.pid
.api.log*
.api.*.pid
.api.*.log
.frontend.*.pid
.frontend.*.log
# ASS-1715: isolated per-worktree test stack state (ports env, frontend pid/log,
# isolated-workspace pointer). Runtime only; never committed.
.worktree-test-stack/
.orchestrator/
.claude/
# tools/ holds local binary tooling (PtyProbe, etc.). Use tools/* so we can
# re-include specific tracked files below; a bare tools/ would prevent any
# whitelisting under it.
tools/*
!tools/remote-test-suite/
!tools/remote-test-suite/**
# Whitelisted: idempotent self-heal script that start.sh runs as a hard
# pre-flight before the backend boots. Tracked so stable picks it up via
# update-stable.sh; everything else under tools/ stays local.
!tools/check-cli-shims.sh
# Whitelisted: the ATB0001 silent-catch Roslyn analyzer. The backend csproj
# references it as an Analyzer ProjectReference, so it must be tracked or the
# build breaks on a fresh checkout.
!tools/SilentCatchAnalyzer/
!tools/SilentCatchAnalyzer/**

.test-output
# Remote Run harness workspaces, credentials, and exported local evidence.
/.tmp/remote-test-suite/

# .NET 10 Artifacts Output Layout (replaces per-project bin/ and obj/)
artifacts/
.claude-screenshots
frontend/e2e/_baselines*
frontend/screenshots/
test-results/
# .NET VSTest/MSTest output: TestResults/<run>.trx (+ any stray .trx). The
# lowercase `test-results/` above did NOT catch backend.Tests/TestResults/*.trx
# (case-sensitive), so be explicit. Build/test artefacts never belong in a commit.
**/TestResults/
*.trx

# Locally-scoped build trees occasionally used to side-step a locked bin/ dir
# (e.g. when the dev backend is running and holds OrchestratorApi.dll). Build
# artifacts only; never source.
**/obj-test/
**/bin-test/

# Loose Playwright screenshots that land in frontend/ when a spec writes
# `screenshot({ path: 'foo.png' })` (relative path → CWD = frontend/).
# Curated visual evidence stays under frontend/playwright-screenshots/
# (tracked); this rule covers depth-1 only so subfolders are not affected.
# When you find a spec writing loose PNGs, fix it to write under
# `frontend/playwright-screenshots/<topic>/...` instead.
frontend/*.png

# Local mockup screenshot evidence is useful during review, but it is generated
# output. Keep it on disk for inspection, not in the source repository.
docs/mockups/**/evidence/*.png
docs/mockups/**/evidence/**/*.png

# Per-checkout local config overrides (e.g. Environment:IsDev for the dev banner)
backend/appsettings.Local.json
.frontend.pid
.frontend.log

# Rolling backend logs (logs/backend/<date>.log + last-crash.json) live at the
# repo root at runtime. Runtime artefacts never belong in source.
logs/

# A task's active cli-output.log remains durable evidence. Its bounded previous
# segment is runtime-only and must never become a second tracked log blob.
**/logs/cli-output.log.1

# ng serve runtime logs (frontend dev server). Per-port files like
# .ng-serve-4021.out.log / .err.log are runtime artefacts; never commit.
frontend/.ng-serve-*.log
frontend/.ng-serve-*.out.log
frontend/.ng-serve-*.err.log
frontend/.ng-serve-*.pid
**/.ng.run.out
**/.ng.run.err
# Catch ad-hoc ng-serve capture files that don't use the .ng-serve-<port> prefix
# (e.g. .develop-layout-compare-ng-serve.out.log) - still runtime noise, never commit.
frontend/*ng-serve*.log
frontend/mockup-chat.*.log
.ng-serve-*.log
.ng-serve-*.out.log
.ng-serve-*.err.log
.ng-serve-*.pid

# .NET per-project build outputs. The .NET 10 layout already redirects most
# output to artifacts/, but freshly-scaffolded projects (e.g. update-service)
# fall back to bin/obj until they pick up the artifacts setting; gitignore
# them universally so a transient build never bleeds into a commit.
**/bin/
**/obj/

# Python dependency-validator test bytecode.
**/__pycache__/
*.py[cod]

# UpdateService launcher artefacts (update-service.sh detached pid + log).
.update-service.pid
.update-service.log

# runtime frontend dev-server logs (not source)
frontend-ngserve.*.log
frontend-server.*.log

# Local UI evidence capture (screenshots + throwaway capture/proxy helpers).
# Task evidence belongs in the task's results/ folder, never in the source
# repo; a crash-recovery auto-commit otherwise sweeps these back in.
frontend/evidence-out/
frontend/capture-evidence.mjs
frontend/debug-styles.mjs
frontend/proxy.stable.json

# ── Repo-root cleanup: artifacts/logs/strays that must never be committed ──
node_modules/
.test-out/
*.out.log
*.err.log
.api-direct.*
frontend-server.*
frontend/.frontend-dev.log
*.zip
/jobs-dump.json
/mini-test-screenshot.png
/presentation/
/scenarios/
/results/

# Repo-root agent scratch scripts are diagnostic runtime artefacts, never
# product source. Keep them out of broad platform-owned snapshot commits.
/.tmp-*.mjs
/tmp-*.mjs

# Container-stack runner identity/tokens (installer writes it from the template)
/runner.env
/runner.token

# Local docker-compose overrides (ports, version pin, distributed tokens).
/.env
