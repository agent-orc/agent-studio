# Bootstrap contract for orchestrator-engine. Flow definitions and operational
# model/gate settings remain Task Server data and are read through its API.
SERVER_URL=http://127.0.0.1:5071
CLIENT_ID=orchestrator-engine-01
# Engine principal credential. Required for non-loopback SERVER_URL values;
# never reuse a Studio or Runner credential here.
CLIENT_CREDENTIAL=
# Explicit opt-in for a trusted private container network only. Keep disabled
# for a remote Task Server, which must use HTTPS.
ENGINE_ALLOW_INSECURE_HTTP=0

REVIEW_CONCURRENCY=4
COUNCIL_CONCURRENCY=4
POST_PROCESSING_CONCURRENCY=3
GATE_DISPATCH_CONCURRENCY=2
COMPLETION_JUDGE_CONCURRENCY=4
BATCH_PLAN_CONCURRENCY=1
POLL_SECONDS=2
LEASE_SECONDS=120
# Default off. Enable only for a bounded Agent Host gate canary; the backend
# post-build-test gate remains active in the first delivery.
REMOTE_POST_BUILD_TEST_GATE_ENABLED=0
# Batch advisor (AGT-3055). The engine calls the advisor model with its own
# provider credential. Without one, every batch decision keeps the
# deterministic look-ahead plan and records an advisor fallback.
ADVISOR_CREDENTIAL=
ADVISOR_MODEL=claude-opus-5
